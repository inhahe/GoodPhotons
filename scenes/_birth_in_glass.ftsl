# BIRTH-EMPTY-STACK: a lamp inside a coloured glass ball. Every light walk is born inside the glass, so it
# must carry the glass's absorption from its birth to the ball's wall, as every camera walk that goes in
# after it does. Judged by tools/check_birth_stack.py (the forward and bidirectional modes against R).
# The lamp is two panels back to back, 4 mm apart: coincident faces would leave a camera ray meeting
# them to pick either, and the unlit back half the time.
scene { units meters }
material "white" { type diffuse reflect 0.75 }
material "amber" { type dielectric  ior 1.5  absorb rgb 0.5 3.0 9.0 }
quad { origin -2 0 -2  u 0 0 4  v 4 0 0  material white }
quad { origin -2 0 -2  u 4 0 0  v 0 3 0  material white }
quad { origin -2 0 -2  u 0 3 0  v 0 0 4  material white }
quad { origin 2 0 -2  u 0 0 4  v 0 3 0  material white }
quad { origin -2 3 -2  u 4 0 0  v 0 0 4  material white }
sphere { center 0 1.0 -0.5  radius 0.45  material amber }
light area { origin -0.08 0.998 -0.58  u 0.16 0 0  v 0 0 0.16  normal 0 -1 0  spd preset:bb6500  power 40 }
light area { origin -0.08 1.002 -0.42  u 0 0 -0.16  v 0.16 0 0  normal 0 1 0  spd preset:bb6500  power 40 }
camera "c" { eye 0 1.4 3.6  look_at 0 1.0 -0.5  up 0 1 0  fov_y 50  film { res 96 72 } }
