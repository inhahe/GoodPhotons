# A/B fixture for `-dual-scatter`: the same pale coat as _dual_pale_lamp.ftsl, but lit ONLY
# by a constant sky — which is the path that goes through envGeom rather than emitterGeom.

scene { units meters  spectral 360 830 1 }

material "black" { type diffuse  reflect 0.0 }
material "polar" { type hair  sigma_a 0.02  beta_m 0.35  beta_n 0.35  alpha 3.0 }

light env { spd preset:d65}

sphere "ball" { center 0.50 0.32 0.55  radius 0.18  material black }
fur "ball_coat" {
    on "ball"
    material polar
    count 90000   points 6   length 0.045  length_jitter 0.3
    radius 0.0004  lift 0.85  jitter 0.25
    gravity 0 -1 0  droop 0.35
}

camera "cam" { eye 0.5 0.42 1.90   look_at 0.5 0.32 0.55   up 0 1 0   fov_y 45 }
