# Thin-gap leak probe, the light-block form (known-issues J-THIN-GAP-LEAK): a diffuse plate 2 mm
# over the floor, a light 1 mm under it facing down. No light from the gap can reach the plate's
# top: every mode should read it as the ceiling panel lights it.
scene { units meters }
camera "c" { eye 0 1.3 3.6  look_at 0 0.3 0  up 0 1 0  fov_y 50  film { res 96 72 } }
material "wall"  { type diffuse reflect 0.6 }
material "floor" { type diffuse reflect 0.5 }
material "plate" { type diffuse reflect 0.5 }
quad { origin -2 0 -2  u 4 0 0  v 0 0 6  material floor }
quad { origin -2 0 -2  u 0 2.6 0  v 4 0 0  material wall }
quad { origin -2 0 -2  u 0 0 6  v 0 2.6 0  material wall }
quad { origin 2 0 -2  u 0 2.6 0  v 0 0 6  material wall }
quad { origin -2 2.6 -2  u 0 0 6  v 4 0 0  material wall }
light area { origin -0.3 2.59 -0.3  u 0.6 0 0  v 0 0 0.6  normal 0 -1 0  spd preset:bb6500  power 4 }
# u x v = -y: the plate emits downward, into the gap
quad { origin -1.5 0.002 -1.5  u 3 0 0  v 0 0 3  material plate }
# a light in the gap, 1 mm under the plate, facing down: its light reaches the plate's underside only
light area { origin -0.5 0.001 -0.5  u 1 0 0  v 0 0 1  normal 0 -1 0  spd preset:bb6500  power 2 }
