# Modes J's and M's beam merges in a fog seen through a gel whose ramp begins on a boundary of the uniform
# bins, lit by a line inside the bin above it (known-issues JSPEC-BIN-RESOLUTION, REVIEW-0458):
# _jfog_gelline's companion, and check_jfog_glass's `gelkink`. The gel passes nothing below 595 nm --
# bin 12's lower edge -- and ramps to 0.9 at 620 nm; the lamp emits a 1 nm line at 610 nm, in bin 12. The
# carriers hold the gel on the scene's cells, which cut it at its bend, bin 12 read where the line is;
# held on the uniform bins, at 604.8 nm and at 624.4 past the bend, the beam gather's carrier and mode J's
# read 610 between them 15 % low (0.451.26: J 0.843 / 0.841 of mode R, GPU / CPU; M 0.852 / 0.865).
# _jfog_gel's fog box over a grey floor, lit by a big sphere lamp from above; every mode at -max-bounce 32.

scene {
    units    meters
    spectral 360 830 1
}

material "grey" { type diffuse reflect 0.5 }
material "gel"  { type filter  transmit table { 360:0 595:0 620:0.9 830:0.9 } }

quad { origin -3 0 -3   u 0 0 6   v 6 0 0   material grey }

quad { origin -0.6 0.1 1.2   u 1.2 0 0   v 0 1.3 0   material gel }

medium {
    sigma_t 3.0   albedo 0.9   g 0.0
    bounds { min -0.4 0.32 -0.4   max 0.4 1.12 0.4 }
}

light sphere { center 0 3.0 0.4   radius 0.7   spd gaussian center=610 sigma=1 }

camera "cam" {
    eye 0 0.9 3.2   look_at 0 0.72 0   up 0 1 0   fov_y 34
    mode J
    film { res 240 200 }
}
