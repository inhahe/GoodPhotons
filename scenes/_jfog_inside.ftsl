# Mode J's merges in a fog inside coloured glass (tools/check_jfog_glass.py; one of
# _jfog_floor / _jfog_behind / _jfog_inside). A fog box over a grey floor, lit by a big sphere lamp
# from above; `tint` absorbs strongly and very unevenly across the band, the case a spectral carrier
# has to get right. Every mode at -max-bounce 32 (D, J and U default to 8 edges, R to 32).
# The merge's partial camera segment runs in the glass, whose absorption has to be taken at the
# beam's wavelength (R 0.73, G 1.24 of mode R before 0.391.3; the merge's glass fix is 0.391.3's,
# measured on 0.391.4).

scene {
    units    meters
    spectral 360 830 1
}

material "grey"  { type diffuse reflect 0.5 }
material "tint"  { type dielectric ior 1.0001  absorb rgb 0.2 2.5 5.0 }

quad { origin -3 0 -3   u 0 0 6   v 6 0 0   material grey }

sphere { center 0 0.72 0  radius 0.72  material tint }

medium {
    sigma_t 3.0   albedo 0.9   g 0.0
    bounds { min -0.4 0.32 -0.4   max 0.4 1.12 0.4 }
}

light sphere { center 0 3.0 0.4   radius 0.7   spd preset:bb6500 }

camera "cam" {
    eye 0 0.9 3.2   look_at 0 0.72 0   up 0 1 0   fov_y 34
    mode J
    film { res 240 200 }
}
