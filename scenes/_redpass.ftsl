# A fog lit through a red-pass glass (known-issues MODEM-REDPASS). A sphere lamp shines on a fog box
# through a glass ball whose absorption is 8/m below 590 nm and exactly 0 above 610 nm, a steep edge
# across the green-red boundary; the camera sees the fog from the side, not through the glass, so the
# camera walk is plain and any error is the light side's or the gather's. The 2026-10-21 report read
# mode M `-beams` 0.998 / 0.917 / 0.971 of mode R in the fog, mode J 1.020 / 1.029 / 0.971, both at
# -max-bounce 32 (that scene was never tracked; this one follows its description).

scene {
    units    meters
    spectral 360 830 1
}

material "grey"    { type diffuse reflect 0.5 }
material "redpass" { type dielectric ior 1.0001  absorb table { 360:8 590:8 610:0 830:0 } }

quad { origin -3 0 -3   u 0 0 6   v 6 0 0   material grey }

sphere { center -0.85 0.7 0  radius 0.45  material redpass }

medium {
    sigma_t 3.0   albedo 0.9   g 0.0
    bounds { min -0.2 0.3 -0.4   max 0.6 1.1 0.4 }
}

light sphere { center -1.6 0.7 0   radius 0.12   power 400   spd preset:bb6500 }

camera "cam" {
    eye 0.2 0.8 2.8   look_at 0.2 0.7 0   up 0 1 0   fov_y 30
    mode M
    film { res 240 200 }
}
