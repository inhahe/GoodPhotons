scene { units meters  spectral 360 830 1 }

shell_a = material { type diffuse  reflect rgb 0.85 0.55 0.30 }
shell_b = material { type diffuse  reflect rgb 0.35 0.65 0.85 }
shell_c = material { type diffuse  reflect rgb 0.55 0.85 0.45 }
shell_d = material { type diffuse  reflect rgb 0.80 0.45 0.75 }
wall = material { type diffuse  reflect 0.72 }

hall/g0 = isosurface {
    material "shell_a"
    function { expr "sin((6*((-1)*(x-(-2.47991e-16))+(0)*y+(1.22465e-16)*(z-(-1.35)))+(1.5708)))*cos((6*((0)*(x-(-2.47991e-16))+(1)*y+(0)*(z-(-1.35)))+(1.5708)))+sin((6*((0)*(x-(-2.47991e-16))+(1)*y+(0)*(z-(-1.35)))+(1.5708)))*cos((6*((-1.22465e-16)*(x-(-2.47991e-16))+(0)*y+(-1)*(z-(-1.35)))+(1.5708)))+sin((6*((-1.22465e-16)*(x-(-2.47991e-16))+(0)*y+(-1)*(z-(-1.35)))+(1.5708)))*cos((6*((-1)*(x-(-2.47991e-16))+(0)*y+(1.22465e-16)*(z-(-1.35)))+(1.5708)))-(0)" }
    contained_by { sphere { center -2.47991e-16 0 -1.35  radius 0.85 } }
}

hall/g1 = isosurface {
    material "shell_b"
    function { expr "cos((5*((-1)*(x-(1.35))+(0)*y+(1.22465e-16)*(z-(-3.30655e-16)))+(1.5708)))+cos((5*((0)*(x-(1.35))+(1)*y+(0)*(z-(-3.30655e-16)))+(1.5708)))+cos((5*((-1.22465e-16)*(x-(1.35))+(0)*y+(-1)*(z-(-3.30655e-16)))+(1.5708)))-(0)" }
    contained_by { sphere { center 1.35 0 -3.30655e-16  radius 0.85 } }
}

hall/g2 = isosurface {
    material "shell_c"
    function { expr "sin((5*((-1)*(x-(4.13318e-16))+(0)*y+(1.22465e-16)*(z-(1.35)))+(1.5708)))*sin((5*((0)*(x-(4.13318e-16))+(1)*y+(0)*(z-(1.35)))+(1.5708)))*sin((5*((-1.22465e-16)*(x-(4.13318e-16))+(0)*y+(-1)*(z-(1.35)))+(1.5708)))+sin((5*((-1)*(x-(4.13318e-16))+(0)*y+(1.22465e-16)*(z-(1.35)))+(1.5708)))*cos((5*((0)*(x-(4.13318e-16))+(1)*y+(0)*(z-(1.35)))+(1.5708)))*cos((5*((-1.22465e-16)*(x-(4.13318e-16))+(0)*y+(-1)*(z-(1.35)))+(1.5708)))+cos((5*((-1)*(x-(4.13318e-16))+(0)*y+(1.22465e-16)*(z-(1.35)))+(1.5708)))*sin((5*((0)*(x-(4.13318e-16))+(1)*y+(0)*(z-(1.35)))+(1.5708)))*cos((5*((-1.22465e-16)*(x-(4.13318e-16))+(0)*y+(-1)*(z-(1.35)))+(1.5708)))+cos((5*((-1)*(x-(4.13318e-16))+(0)*y+(1.22465e-16)*(z-(1.35)))+(1.5708)))*cos((5*((0)*(x-(4.13318e-16))+(1)*y+(0)*(z-(1.35)))+(1.5708)))*sin((5*((-1.22465e-16)*(x-(4.13318e-16))+(0)*y+(-1)*(z-(1.35)))+(1.5708)))-(0)" }
    contained_by { sphere { center 4.13318e-16 0 1.35  radius 0.85 } }
}

hall/g3 = isosurface {
    material "shell_d"
    function { expr "3*(cos((4*((-1)*(x-(-1.35))+(0)*y+(1.22465e-16)*(z-(4.95982e-16)))+(1.5708)))+cos((4*((0)*(x-(-1.35))+(1)*y+(0)*(z-(4.95982e-16)))+(1.5708)))+cos((4*((-1.22465e-16)*(x-(-1.35))+(0)*y+(-1)*(z-(4.95982e-16)))+(1.5708))))+4*cos((4*((-1)*(x-(-1.35))+(0)*y+(1.22465e-16)*(z-(4.95982e-16)))+(1.5708)))*cos((4*((0)*(x-(-1.35))+(1)*y+(0)*(z-(4.95982e-16)))+(1.5708)))*cos((4*((-1.22465e-16)*(x-(-1.35))+(0)*y+(-1)*(z-(4.95982e-16)))+(1.5708)))-(0)" }
    contained_by { sphere { center -1.35 0 4.95982e-16  radius 0.85 } }
}
quad { origin -3 -1.6 -3  u 6 0 0  v 0 0 6  material "wall" }
quad { origin -3  2.0 -3  u 6 0 0  v 0 0 6  material "wall" }
quad { origin -3 -1.6 -3  u 6 0 0  v 0 3.6 0  material "wall" }
quad { origin -3 -1.6 -3  u 0 0 6  v 0 3.6 0  material "wall" }
quad { origin  3 -1.6 -3  u 0 0 6  v 0 3.6 0  material "wall" }

light { kind area  origin -2.2 1.98 -2.2  u 4.4 0 0  v 0 0 4.4  normal 0 -1 0  spd preset:bb6500 }

cam = camera {
    eye 0 1.1 6.4  look_at 0 0 0  up 0 1 0  fov_y 42
    mode R
    film { res 420 420 }
}
