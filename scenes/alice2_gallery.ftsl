# Alice2 FOR gallery_rain -- GENERATED by tools/alice2_gallery.py from the doll and the v3 hair
# rig (alice2_hyper3d/hair_opus5.5_v3/alice2_hair_groom.ftsl, and the headband from alice2_real_hair_eyes.ftsl),
# placed in the hall. Do not edit: rerun the tool.
#
# Meshes carry the placement as their own transform, the curves inside a `group`; the fur
# blocks' lengths are times the scale 0.464458.

# the doll, her sculpted hair (glTF material root.1) left out for the strands below; the
# fallback material is gallery_rain's `alice_unpainted`. `import_metal mix`: her dress's
# sequins are a clean metal mask in the metallicRoughness map, read texel by texel so
# they glint as metal (by the map's mean the whole dress is non-metal, the sparkle only paint)
mesh "alice2" { file "meshes/alice2_doll.glb"  material alice_unpainted  skip_material root.1
    import_metal mix
    translate 9.150000 0.900000 3.550000   rotate 0 20 0   scale 0.464458 }

include "../meshes/alice2_gallery_guides.ftsl"     # alice2_hair_guides.ftsl, placed

material "alice2_scalp_mat" { type diffuse reflect 0.5 }
mesh "alice2_scalp_fr" { file "meshes/alice2_scalp_fr.obj"  material alice2_scalp_mat  shape_only yes
    translate 9.150000 0.900000 3.550000   rotate 0 20 0   scale 0.464458 }
mesh "alice2_scalp_fl" { file "meshes/alice2_scalp_fl.obj"  material alice2_scalp_mat  shape_only yes
    translate 9.150000 0.900000 3.550000   rotate 0 20 0   scale 0.464458 }
mesh "alice2_scalp_bk" { file "meshes/alice2_scalp_bk.obj"  material alice2_scalp_mat  shape_only yes
    translate 9.150000 0.900000 3.550000   rotate 0 20 0   scale 0.464458 }

# synthetic doll fibre: eta 1.55, no cuticle tilt, no medulla; `reflect` calibrated against
# the photos (v2, tools/alice2_hair.py)
material "alice2_hair" { type hair  eta 1.55  alpha 0  reflect rgb 0.98 0.60 0.28  beta_m 0.11  beta_n 0.28 }

fur "alice2_hair_fr" {
    on "alice2_scalp_fr"   material alice2_hair
    count 40377
    guides "alice2_guides_fr"   guide_blend 1
    points 56   segments 2   spline centripetal
    radius 0.0001114698   radius_tip 0.0000891759
    length_jitter 0.03   jitter 0.0
    clump 0.00   clump_size 0.0037156612
    root_offset 0.0002322288
    seed 7
    length 0.0232228825   # the loader's defaults, scaled
}

fur "alice2_hair_fl" {
    on "alice2_scalp_fl"   material alice2_hair
    count 34764
    guides "alice2_guides_fl"   guide_blend 1
    points 56   segments 2   spline centripetal
    radius 0.0001114698   radius_tip 0.0000891759
    length_jitter 0.03   jitter 0.0
    clump 0.00   clump_size 0.0037156612
    root_offset 0.0002322288
    seed 8
    length 0.0232228825   # the loader's defaults, scaled
}

fur "alice2_hair_bk" {
    on "alice2_scalp_bk"   material alice2_hair
    count 54859
    guides "alice2_guides_bk"   guide_blend 1
    points 56   segments 2   spline centripetal
    radius 0.0001114698   radius_tip 0.0000891759
    length_jitter 0.03   jitter 0.0
    clump 0.00   clump_size 0.0037156612
    root_offset 0.0002322288
    seed 9
    length 0.0232228825   # the loader's defaults, scaled
}

# the flyaways (they wear the fibre above)
include "../meshes/alice2_gallery_flyaways.ftsl"

# the black satin headband and bow
material "alice2_ribbon_body" { type diffuse reflect 0.022 }
material "alice2_ribbon" { type layered  ior 1.5  coat { roughness 0.32 }  layer "alice2_ribbon_body" 1.0 }
mesh "alice2_headband" { file "meshes/alice2_headband.obj"  material alice2_ribbon
    translate 9.150000 0.900000 3.550000   rotate 0 20 0   scale 0.464458 }
