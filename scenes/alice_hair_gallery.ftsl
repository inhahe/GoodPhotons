# Alice's hair FOR gallery_rain -- the same groom as alice_hair.ftsl, carried into the hall's frame.
#
#     include "alice_hair_gallery.ftsl"      (gallery_rain.ftsl, right after its `mesh "alice"` block)
#
# The doll herself stays gallery_rain's own `mesh "alice"` block (translate 9.15 1.281363 3.55,
# rotate 0 20 0, scale 3.0). Everything here carries that SAME placement: the scalp cap as a
# `shape_only` mesh with the same transform, the guides inside a `group` with it (generated by
# `tools/alice_guides.py --place 9.15 1.281363 3.55 20 3.0`), and the fur's metre numbers -- fiber
# radius, lock size, root offset, the face zone -- multiplied by the display scale 3.0. `count`
# is a count and does not scale. Regenerate this file's guides whenever alice_guides.ftsl changes.

material "alice_scalp_mat" { type diffuse reflect 0.5 }
mesh "alice_scalp" { file "meshes/alice_scalp_cap.obj"  material alice_scalp_mat  shape_only yes
    translate 9.15 1.281363 3.55   rotate 0 20 0   scale 3.0 }

include "alice_guides_gallery.ftsl"

# the sculpt's own colour: linear (0.79, 0.44, 0.155)
material "alice_hair" { type hair  preset human  reflect rgb 0.79 0.44 0.155  beta_m 0.3  beta_n 0.35 }

fur "alice_hair" {
    on "alice_scalp"   material alice_hair
    count 15000
    guides "alice_hair"
    guide_blend 3
    points 8   segments 3   spline centripetal
    radius 0.00015  radius_tip 0.00012   # 0.05 mm true-size fiber x 3.0
    length_jitter 0.12
    jitter 0.04
    clump 0.7   clump_size 0.0099        # 3.3 mm true-size locks x 3.0
    curl 0.04   curl_freq 1.5
    root_offset 0.0004
    bald 9.1706 1.5664 3.6067 0.0441       # the FACE below the brow, in hall coordinates (+z swings toward +x under rotate 0 20 0 -- measured, tools/curve_rig.py)
    seed 7
}
