# Gallery Hall — a large museum room, pared back to a handful of hero pieces on stone
# plinths, lit by a SINGLE overhead bulb. A gold GYROID lattice ball (a thickened
# triply-periodic minimal surface, clipped to a sphere) is the centrepiece; on the open
# centre line sits the dense-flint hero orb the fly-path dives through. Around them:
# an algebraic KLEIN BOTTLE in glass (the intricate transparent piece), a tilted algebraic
# HEART in morpho-blue iridescence, a chrome MIRROR ring, and two brass CSG studies
# (a fused cluster and a dumbbell-ring). One warm ~4200 K bulb pools light on the centre
# and fades into the corners; the thin hall haze turns it into a soft volumetric glow.
# A polished floor mirrors it all. Rendered with the backward path tracer (mode R), which
# resolves the interior GI and the specular metals/glass far better than the forward splat.
#
#   ftrace -in scenes/gallery.ftsl -mode R -device gpu -noise 2 -window -o png/gallery.png
#   # quick look:  ftrace -in scenes/gallery.ftsl -mode R -device gpu -spp 200 -r 640 360 -o png/gallery.png

scene { units meters  spectral 360 830 1 }

# --- Surfaces ------------------------------------------------------------------
material "floor"  { type glossy     reflect rgb 0.40 0.36 0.32   roughness 0.28 }  # polished stone
material "ceil"   { type diffuse    reflect whitewall 0.82 }
material "teal"   { type diffuse    reflect rgb 0.16 0.28 0.32 }                   # back wall
material "red"    { type diffuse    reflect rgb 0.46 0.26 0.24 }                   # left wall (muted terracotta)
material "green"  { type diffuse    reflect rgb 0.28 0.38 0.30 }                   # right wall (muted sage)
material "stone"  { type diffuse    reflect rgb 0.20 0.19 0.18 }                   # dark plinths

# --- Objects -------------------------------------------------------------------
material "gold"    { preset gold }
material "copper"  { preset copper }
material "silver"  { preset silver }
material "chrome"  { preset chrome }
material "brass"   { preset brass }
material "glass"   { type dielectric ior glass:BK7 }
# Hero fly-through orb: dense flint (SF10, n~1.73 @ 589 nm, Abbe ~28 -> strong
# dispersion). Higher IOR than BK7 tightens the refractive focus and the extra
# dispersion splays the caustic into a coloured fan -- the "obvious caustic" lever.
material "heroglass" { type dielectric ior glass:SF10 }
material "diamond" { preset diamond }
material "morpho"  { preset morpho }
material "oil"     { preset oil-slick }
material "bubble"  { preset soap-bubble }
material "nacre"   { preset nacre }
material "wax"     { type translucent  reflect rgb 0.80 0.55 0.30   transmit rgb 0.70 0.45 0.25 }

# --- The hall: 9 wide (x) x 4.5 tall (y) x 15.5 deep (z). The extra depth lets the
# camera sit well back (z=14.6) with a NARROW 44deg lens: a wide lens (the old 52deg
# at z=12.2) is rectilinear, so it stretches spheres near the frame edges into ovals
# (off-axis solid-angle distortion). Pulling back + narrowing keeps the outer pieces
# comfortably inside ~24deg of the axis where that stretch is negligible. ---
quad { origin 0 0 0    u 9 0 0    v 0 0 15.5   material floor }   # floor
quad { origin 0 4.5 0  u 0 0 15.5 v 9 0 0      material ceil  }   # ceiling
quad { origin 0 0 0    u 0 4.5 0  v 9 0 0      material teal  }   # back  (z=0)
quad { origin 0 0 15.5 u 0 4.5 0  v 9 0 0      material ceil  }   # front (z=15.5, behind camera)
quad { origin 0 0 0    u 0 0 15.5 v 0 4.5 0    material red   }   # left  (x=0)
quad { origin 9 0 0    u 0 4.5 0  v 0 0 15.5   material green }   # right (x=9)

# =========================  CENTREPIECE (KEPT)  ================================
# Broad low plinth (top at y=0.6) carrying the gold gyroid lattice ball.
isosurface { material stone  box { center 4.5 0.30 6.0   size 2.2 0.60 2.2   round 0.05 } }
isosurface {
    material gold
    intersect {
        function {
            translate 4.5 1.38 6.0
            # k=10 lattice, thickness 0.45: an open enough channel network that the
            # camera_curve below threads a ~11 cm-clearance tunnel through the empty
            # space (found by scraps/gyroid_path.py) without touching a gold strut.
            expr "abs(sin(10*x)*cos(10*y) + sin(10*y)*cos(10*z) + sin(10*z)*cos(10*x)) - 0.45"
        }
        sphere { center 4.5 1.38 6.0   radius 0.78 }
    }
    contained_by { min 3.70 0.58 5.20   max 5.30 2.18 6.80 }
    max_gradient 40
}

# The MIDDLE SPHERE (KEPT): the fly-through hero orb on the OPEN centre line (x=4.35),
# dense flint (SF10) so the dive through its centre gives a strong dispersive refraction
# beat. The `camera_curve "fly"` plunges straight through it. On its own tall plinth.
isosurface { material stone  box { center 4.35 0.40 9.5   size 0.9 0.8 0.9   round 0.03 } }
sphere { center 4.35 1.35 9.5   radius 0.55   material heroglass }

# =========================  NEW PIECES  ========================================
# The hall was stripped back to just the gyroid + the hero orb above; everything below
# is the new set. Placement trick: the unit-cube gallery CSG definitions (05/07/09) are
# dropped in VERBATIM and relocated with a TOP-LEVEL translate+scale on the isosurface,
# which composes down into every CSG leaf AND the contained_by box (ftsl.h buildFieldStmt
# threads rootXf through all children), so `local 0.5 -> translate + 0.5*scale` centres
# the unit cube on its plinth.

# --- INTRICATE TRANSPARENT OBJECT: an algebraic Klein bottle in glass (front-left). ---
# Own function (the Ian-Stewart quartic, NOT a POV blob), params from tools/klein_explorer.html
# a=1.2 b=0.6 c=3 d=18.5, iso-level 0.15 -> a solid-walled bottle that refracts cleanly.
# r*r == x^2+y^2+z^2 in the expr evaluator. Object-space clip radius 5 * scale 0.12 = 0.60 m.
isosurface { material stone  box { center 1.9 0.45 8.6   size 0.75 0.9 0.75   round 0.03 } }
isosurface {
    material glass
    function {
        scale 0.12   translate 1.9 1.50 8.6   rotate 12 28 0
        expr "clamp(-((r*r + 1.2*y - 0.6)*((r*r - 1.2*y - 0.6)*(r*r - 1.2*y - 0.6) - 3*z*z) + 18.5*x*z*(r*r - 1.2*y - 0.6) - 0.15), -10, 10)"
    }
    contained_by { sphere { center 1.9 1.50 8.6   radius 0.62 } }
    max_gradient 40
    open
}

# --- IRIDESCENT: tilted algebraic heart (gallery pick 07) in morpho-blue (front-right). ---
isosurface { material stone  box { center 7.1 0.45 8.6   size 0.75 0.9 0.75   round 0.03 } }
isosurface {
    material morpho
    translate 6.675 0.975 8.175   scale 0.85
    function {
        translate 0.5 0.5 0.5   scale 0.24   rotate 22 36 -12
        expr "(x^2 + (9/4)*z^2 + y^2 - 1)^3 - x^2*y^3 - (9/80)*z^2*y^3"
    }
    contained_by { min 0.14 0.14 0.2   max 0.86 0.86 0.8 }
    max_gradient 60
}

# --- BRASS CSG cluster (gallery pick 05): nested smooth_union of spheres+tori with two
# spheres bored out (mid-left plinth). SDF leaves stay unit-Lipschitz, so no max_gradient. ---
isosurface { material stone  box { center 2.0 0.50 5.4   size 0.70 1.0 0.70   round 0.03 } }
isosurface {
    material brass
    translate 1.6 1.0 5.0   scale 0.8
    difference {
    difference {
    smooth_union { k 0.038
        smooth_union { k 0.050
        smooth_union { k 0.039
        smooth_union { k 0.035
        smooth_union { k 0.032
        smooth_union { k 0.042
        sphere { center 0.642 0.391 0.564  radius 0.137 }
        sphere { center 0.602 0.392 0.536  radius 0.133 }
    }
        torus { translate 0.369 0.629 0.403  rotate 155 167 28  major 0.201  minor 0.041 }
    }
        sphere { center 0.671 0.427 0.395  radius 0.092 }
    }
        sphere { center 0.566 0.601 0.542  radius 0.097 }
    }
        sphere { center 0.365 0.665 0.501  radius 0.128 }
    }
        torus { translate 0.390 0.561 0.494  rotate 152 95 79  major 0.150  minor 0.060 }
    }
    sphere { center 0.435 0.587 0.480  radius 0.070 }
    }
    sphere { center 0.520 0.500 0.495  radius 0.071 }
    }
    contained_by { min 0.12 0.12 0.22   max 0.88 0.88 0.78 }
}

# --- MIRRORED: an upright chrome torus ring (mid-right plinth). A clean mirror reflects
# the whole hall + the single bulb around its curve. ---
isosurface { material stone  box { center 7.0 0.50 5.4   size 0.70 1.0 0.70   round 0.03 } }
isosurface {
    material chrome
    torus { translate 7.0 1.44 5.4   rotate 90 0 0   major 0.34   minor 0.10 }
}

# --- BRASS dumbbell-ring (gallery pick 09): two spheres joined by a fused bar + ring,
# with a small bite bored out (back plinth). ---
isosurface { material stone  box { center 6.8 0.45 3.3   size 0.70 0.9 0.70   round 0.03 } }
isosurface {
    material brass
    translate 6.41 0.96 2.91   scale 0.78
    difference {
    smooth_union { k 0.046
        smooth_union { k 0.033
        smooth_union { k 0.032
        sphere { center 0.340 0.500 0.500  radius 0.150 }
        sphere { center 0.660 0.500 0.500  radius 0.150 }
    }
        cylinder { translate 0.500 0.500 0.500  rotate 0 0 90  radius 0.065  height 0.340 }
    }
        torus { translate 0.500 0.500 0.500  rotate 0 0 90  major 0.150  minor 0.045 }
    }
    sphere { center 0.369 0.528 0.501  radius 0.067 }
    }
    contained_by { min 0.08 0.08 0.12   max 0.92 0.92 0.88 }
}

# =========================  LIGHTING  ==========================================
# A SINGLE light bulb hung over the hall centre. One warm ~4200 K sphere source is the
# whole illumination: strong falloff gives a dramatic, gallery-at-night pool of light on
# the centrepieces that fades into the corners, and the thin hall haze (medium below)
# turns it into a soft volumetric glow. Small enough to throw a crisp dispersive caustic
# down through the SF10 orb, big enough (r=0.32) to carry real power and soft shadows.
light sphere { center 4.5 3.7 7.6   radius 0.55   spd blackbody 4200 }

# --- Atmosphere: a faint hall haze. Participating media is BUILT IN (Henyey-Greenstein
# phase + delta/ratio tracking), so this thin homogeneous fog gives the whole hall aerial
# depth and lets the ceiling lights cast soft volumetric shafts. Mode R renders a
# HOMOGENEOUS GLOBAL medium like this; for a BOUNDED or HETEROGENEOUS glowing fog
# (sigma via `bounds { ... }` / a `density "expr"` field) render mode D (BDPT), which
# resolves fog-through-glass and varying density that the mode-R/forward paths cannot.
medium { sigma_t 0.016   albedo 0.85   g 0.6 }

camera "cam" {
    eye 4.5 1.90 14.6   look_at 4.5 1.15 5.8   up 0 1 0   fov_y 44
    mode R
    film { res 1280 720   exposure 11.0 }
}

# --- Flythrough: a SEAMLESS LOOP that dives through the glass orb, threads the gyroid's
# empty channel, then sweeps back over the hall to where it began ---
# A smooth CLOSED Catmull-Rom flight that (1) starts up near the hero viewpoint, (2) plunges
# straight through the centre of the fly-through glass orb (z=9.5) for a refraction beat,
# (3) enters the gyroid clip-sphere at its +z face and follows the widest empty tunnel
# through the lattice (11 cm bottleneck clearance, control points from scraps/gyroid_path.py
# for k=10 / T=0.45) WITHOUT touching a gold strut, then (4) emerges out the -z face and
# banks up-and-left (swerving clear of the nacre sphere dead ahead at (4.5,1.30,3.0)), then
# (5) climbs to a gentle, moderate-height establishing glide (peak y~2.6) that sweeps forward
# over the whole hall — above every plinth, beside the y=3.0 chrome column — looking DOWN the
# hall rather than up into the ceiling lights, and (6) curls back down at the front to REJOIN
# the start point, so `closed` makes frame N == frame 0 for a gap-free looping gif. The dive
# control points (through the orb and the lattice) are UNCHANGED, so the delicate threading
# is preserved; only the return glide is new. `look tangent` keeps the lens aimed along
# travel, `density_at` dwells on the money shots (orb + tunnel) and speeds the return, and
# `exposure_lock` freezes frame 0's auto-exposure across all frames so the loop never flickers.
# Render one frame with, e.g.,
#   ftrace -in scenes/gallery.ftsl -mode R -device gpu -noise 2 -window -camera "#50" -o png/fly.png
# Render the whole looping video via ONE shared photon map (mode M builds the map ONCE and
# gathers every frame from it — the multi-camera win, since this foggy scene can't use the
# backward-GPU path). K=0 direct density query keeps the per-frame gather cheap; spp averages
# out the dielectric caustic speckle (which also temporally-averages in motion):
#   ftrace -in scenes/gallery.ftsl -mode M -n 8000000 -spp 16 -r 480 270 -o png/gallery.png
# then assemble png/gallery_fly*.png into a seamless gif (drop no frames — frame N == frame 0).
camera_curve "fly" {
    point 4.50  2.05 11.60     # start: up in the hall (raised so the closure fold stays LEVEL - see below)
    point 4.42  1.70 10.50     # descend toward the orb
    point 4.35  1.35  9.50     # THROUGH the glass orb's centre
    point 4.35  1.33  8.05     # coast through the open centre of the front row (z=8.6)
    point 4.35  1.32  7.55     # final approach to the lattice ball
    point 4.350 1.305 6.615    # channel entry  (+z face of the clip sphere)
    point 4.366 1.451 6.345    # interior control points threading the empty channel
    point 4.260 1.316 6.100
    point 4.411 1.384 5.835
    point 4.261 1.432 5.576
    point 4.335 1.305 5.385    # channel exit  (-z face)
    point 4.30  1.38  4.60     # emerge behind the ball
    point 3.90  1.52  3.70     # bank up-and-LEFT across the open back of the hall
    point 3.30  1.70  2.70
    point 2.60  1.84  1.90     # finish the dive, back-left of the hall
    # --- return glide (reshaped v2): a smooth, MOSTLY-LEVEL cruise back to the start. `look
    # tangent` aims a fixed arc-length AHEAD along the path, so wherever the path makes a
    # horizontal U-turn (a "fold") while ALSO changing height, the look-ahead reaches across
    # the fold to a point at a very different y and the view pitches HARD -- a jerky flick.
    # This path has two folds: (A) the dive turnaround here (back-left corner, frames ~117-120)
    # and (B) the closure at the front (z~12.8, frames ~171-175). The old arc climbed to y~2.6
    # over BOTH, so at (A) the tangent stared UP into the y=4.48 lights (peak +24.5deg) and at
    # (B) it stared DOWN at the floor (peak -70deg). Fix: keep y as FLAT as possible ACROSS
    # each fold so the look-ahead stays level -- the apex now peaks at only ~y2.2, the turnaround
    # is +10.6deg and the closure -15deg (max frame-to-frame swing 6.5deg, was ~30deg). The
    # height change is pushed onto the STRAIGHT opening corridor (p0->orb) where a steeper look
    # reads fine. Still glides above every plinth in the pared-back hall. ---
    point 2.35  1.90  2.90     # ease up out of the dive, staying LEVEL across the turnaround fold
    point 2.80  2.00  5.10     # reach cruise height, gliding forward down the hall
    point 3.40  2.13  7.60     # near-level establishing sweep over the hall centre-left
    point 4.00  2.20 10.00     # continue forward, above the glass orb (clears its y~1.9 top)
    point 4.30  2.18 12.30     # approach the front fold LEVEL (was a steep descent -> down-stare)
    point 4.58  2.16 12.80     # curl back toward the start, still level (drop to y2.05 happens after)
    up 0 1 0   fov_y 72   mode R   frames 180
    look tangent
    # Centripetal Catmull-Rom (alpha 0.5): the waypoints down the hall and around the
    # high return arc are unevenly spaced, and plain uniform Catmull-Rom overshoots
    # between them -- the eye path bulges and wobbles, so the room flight reads jerky.
    # Centripetal knots (chord^0.5) stay tight to the points with no overshoot/looping.
    spline centripetal
    # dwell on the orb + tunnel, race through the high return (t is normalised curve position)
    density_at 0.00 8   density_at 0.10 16   density_at 0.24 22   density_at 0.48 22
    density_at 0.58 10  density_at 0.667 6   density_at 1.00 6
    # Two bare flag-keywords must each go on their OWN line: a value-less keyword still
    # consumes the next bareword as its value (the grammar can't tell `closed exposure_lock`
    # from `material white`), so `closed exposure_lock` on one line would silently drop the lock.
    closed
    exposure_lock
    film { res 1280 720   exposure 11.0 }
}
