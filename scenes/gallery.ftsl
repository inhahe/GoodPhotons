# Gallery Hall — a busy material showcase in a large interior room. A gold GYROID
# lattice ball (thickened triply-periodic minimal surface, clipped to a sphere) is the
# centrepiece, surrounded by a spread of objects that each exercise a different BSDF:
# clear glass and diamond dielectrics, copper / silver / chrome / brass conductors,
# structural-colour iridescents (morpho, oil-slick, soap-bubble, mother-of-pearl),
# smooth-union metaballs, hard CSG, and a wax translucent (diffuse-transmission) sphere.
# The polished floor softly mirrors them all and warm/cool accent lights tint the walls,
# so there's a lot going on from every angle. Rendered with the backward path tracer
# (mode R), which resolves the interior global illumination and the specular metals/glass
# far better than the forward splat.
#
#   ftrace -in scenes/gallery.ftsl -mode R -device gpu -spp 4096 -window -o png/gallery.png
#   # quick look:  ftrace -in scenes/gallery.ftsl -mode R -device gpu -spp 256 -r 640 360 -o png/gallery.png

scene { units meters  spectral 360 830 1 }

# --- Materials -----------------------------------------------------------------
material "floor"  { type glossy     reflect rgb 0.40 0.36 0.32   roughness 0.28 }  # polished stone
material "ceil"   { type diffuse    reflect whitewall 0.80 }
material "teal"   { type diffuse    reflect rgb 0.16 0.28 0.32 }                   # back wall
material "red"    { type diffuse    reflect rgb 0.46 0.26 0.24 }                   # left wall (muted terracotta)
material "green"  { type diffuse    reflect rgb 0.28 0.38 0.30 }                   # right wall (muted sage)

material "gold"    { preset gold }
material "copper"  { preset copper }
material "silver"  { preset silver }
material "chrome"  { preset chrome }
material "brass"   { preset brass }
material "glass"   { type dielectric ior glass:BK7 }
material "diamond" { preset diamond }
material "morpho"  { preset morpho }
material "oil"     { preset oil-slick }
material "bubble"  { preset soap-bubble }
material "nacre"   { preset nacre }
material "wax"     { type translucent  reflect rgb 0.80 0.55 0.30   transmit rgb 0.70 0.45 0.25 }

# --- The room: 5 wide (x) x 3 tall (y) x 7 deep (z). Camera sits inside near z=6.5. ---
quad { origin 0 0 0   u 5 0 0   v 0 0 7   material floor }   # floor
quad { origin 0 3 0   u 0 0 7   v 5 0 0   material ceil  }   # ceiling
quad { origin 0 0 0   u 0 3 0   v 5 0 0   material teal  }   # back  (z=0)
quad { origin 0 0 7   u 0 3 0   v 5 0 0   material ceil  }   # front (z=7, behind camera)
quad { origin 0 0 0   u 0 0 7   v 0 3 0   material red   }   # left  (x=0)
quad { origin 5 0 0   u 0 3 0   v 0 0 7   material green }   # right (x=5)

# --- Hero: gold gyroid lattice ball (thickened TPMS sheet clipped to a sphere) -------
# The field is translated to the ball centre so the sin/cos lattice is centred on it.
isosurface {
    material gold
    intersect {
        function {
            translate 2.5 0.9 2.7
            expr "abs(sin(14*x)*cos(14*y) + sin(14*y)*cos(14*z) + sin(14*z)*cos(14*x)) - 0.5"
        }
        sphere { center 2.5 0.9 2.7   radius 0.78 }
    }
    contained_by { min 1.70 0.10 1.90   max 3.30 1.70 3.50 }
    max_gradient 48
}

# --- Dielectrics: clear glass + a brilliant diamond, near the camera. Each has a
# small glowing accent orb tucked behind it (below) so it refracts something bright. ---
sphere { center 1.10 0.50 4.8   radius 0.48   material glass   }
sphere { center 3.92 0.46 4.5   radius 0.44   material diamond }

# --- Conductors --------------------------------------------------------------------
# Copper torus tilted to face the camera (translate = rotate in place; see FTSL §10.1).
isosurface {
    material copper
    torus { translate 1.30 0.95 3.7   rotate 72 0 0   major 0.34   minor 0.10 }
}
# Silver metaballs (smooth union).
isosurface {
    material silver
    blob {
        k 0.12
        sphere { center 3.60 0.42 3.4   radius 0.24 }
        sphere { center 3.86 0.46 3.5   radius 0.22 }
        sphere { center 3.72 0.66 3.5   radius 0.20 }
    }
}
# Chrome mirror pillar in the back-left corner (reflects the whole room).
isosurface {
    material chrome
    cylinder { translate 0.62 0.90 0.95   radius 0.26   height 1.80 }
}
# Brass hard-CSG block near the camera: a rounded box with a sphere bored out.
isosurface {
    material brass
    difference {
        box    { center 2.5 0.42 5.35   size 0.66 0.66 0.66   round 0.06 }
        sphere { center 2.5 0.42 5.05   radius 0.34 }
    }
}

# --- Structural colour (iridescents) -----------------------------------------------
sphere { center 0.78 0.45 2.3   radius 0.45   material morpho }   # back-left, blue
sphere { center 4.28 0.45 2.2   radius 0.45   material oil    }   # back-right, rainbow
sphere { center 3.10 0.40 1.4   radius 0.40   material nacre  }   # back, pearlescent
# Floating soap bubble above the hero.
sphere { center 2.45 1.78 3.95   radius 0.32   material bubble }

# --- Translucent wax sphere (diffuse transmission / thin-SSS look) ------------------
sphere { center 1.90 0.40 1.5   radius 0.40   material wax }

# --- Lighting: three broad neutral key lights down the hall + warm & cool accents ---
light area { origin 1.3 2.98 5.0   u 1.4 0 0   v 0 0 1.0   normal 0 -1 0   spd preset:d65 }
light area { origin 1.3 2.98 3.1   u 1.4 0 0   v 0 0 1.0   normal 0 -1 0   spd preset:d65 }
light area { origin 1.0 2.98 0.9   u 2.0 0 0   v 0 0 1.1   normal 0 -1 0   spd preset:d65 }       # broad back wash
light area { origin 3.7 2.6  0.9   u 0.7 0 0   v 0 0 0.6   normal 0 -1 0   spd blackbody 3000 }  # warm accent
light area { origin 0.4 2.6  1.6   u 0.5 0 0   v 0 0 0.7   normal 0 -1 0   spd blackbody 8500 }  # cool accent
# Small glowing decor orbs: colour points that also light (and refract inside) the
# glass and diamond in front of them.
light sphere { center 1.00 0.42 3.85   radius 0.11   spd blackbody 2500 }   # warm, behind glass
light sphere { center 4.02 0.40 3.7    radius 0.11   spd blackbody 9000 }   # cool, behind diamond
light sphere { center 2.50 0.16 4.55   radius 0.09   spd blackbody 5500 }   # low centre spark

camera "cam" {
    eye 2.5 1.45 6.5   look_at 2.5 0.92 2.6   up 0 1 0   fov_y 54
    mode R
    film { res 1280 720   exposure 1.45 }
}
