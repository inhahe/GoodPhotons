group { translate 0.60 0 -0.54         # --- exhibit: BRASS CLUSTER ---
isosurface "stand_brass" {   # cap top y=0.95
    # Moved from z=2.0 to z=1.84: at 2.0 its base slab (z 1.65..2.35) overlapped the klein
    # stand's base slab (z 2.24..2.96) by 0.11 m, another pre-existing wireframe-through-
    # wireframe intersection. The settled brass cluster below is shifted by the same -0.16.
    material wirecage  union {
