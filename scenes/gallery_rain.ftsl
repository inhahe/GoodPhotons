            box { center 6.0 0.58 1.84  size 0.38  0.658 0.338 }
            box { center 6.0 0.58 1.84  size 0.338 0.7   0.338 }
            box { center 6.0 0.58 1.84  size 0.338 0.658 0.38  }
        }
    }
}
