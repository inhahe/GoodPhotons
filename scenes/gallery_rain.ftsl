# --- exhibit: CRYSTAL AXICON (the tenth stand, and the only NEW one) -------------------
# Authored directly in WORLD coordinates, with no `group { translate }` wrapper — unlike the
# other nine it has no earlier layout position to be displaced from, so there is nothing to
# offset and a `translate 0 0 0` would be noise. `scraps/_standaudit.py` sums enclosing
# group translates and simply gets (0,0,0) here, which is correct.
#
# WHY IT EXISTS: nothing in this scene threw a COLOURED caustic. See the piece itself, down
# in HERO PIECES, for the measurements; the short version is that the orb and both gyroids
# make a white or faintly-tinted patch and the axicon makes a spectrum.
#
# WHY HERE: near-left, at (2.60, 5.45). Four constraints picked it and all four are checked:
#   * clear of every existing cap and of the crystal gyroid it stands beside. Its cap reaches
#     z=4.78 and stand_diamond_cap ends at z=4.40 (0.38 m); the gyroid ball itself ends at
#     z=4.65 and this piece starts at 4.89 (0.24 m). `scraps/_standaudit.py` checks the caps
#     and cages; `-v` prints every footprint, which is what to read before siting anything.
#   * clear of the FLYBY, by 1.53 m (`scraps/_flyplan.py` carries it as a collider).
#   * IN FRAME and UNOCCLUDED for the still camera at (5.0, 2.95, 9.35), 29.5 deg off axis
#     against a 40.9 deg half-width. THE NEAR ROW IS HIGH z, NOT LOW z — the camera stands at
#     z=9.35 and looks toward -z, so "front of the gallery" means z around 5-7, and the first
#     siting of this piece (at z=1.10, which reads as "front" on the page) put it 8.4 m away
#     and directly BEHIND the crystal gyroid, which occluded it completely. At z=5.45 it is
#     4.2 m out and 178 px/m, so the cone renders larger than the gyroid ball beyond it.
#     They USED to clear each other on screen by ~24 px. THEY NO LONGER DO: SF10's optimum
#     drop is 0.65 rather than crystal's 0.35 (see the piece), which lifted it 0.30 m, and at
#     1280x720 the cone (x 90..322, y 421..563) now crosses the gyroid ball (x 229..381,
#     y 312..451) over a 93 x 30 px box at the cone's APEX. Checked on the finished frame and
#     KEPT: what overlaps is the cone's two straight silhouette edges converging over the
#     gyroid's lower filigree — a hard geometric line against a busy one, 1.3 m nearer — so
#     it reads as a near piece in front of a far piece, not as clutter. Moving it is not free
#     either: the cap already runs off the left edge (x -21), so the obvious leftward dodge
#     pushes more of it out of frame.
#   * it balances the frame. The right half carries the gold gyroid, the orb, the cloud and
#     the rain; the near-left was empty grid, and the scene's whole reason for losing its roof
#     was that its left half sat in permanent shadow.
isosurface "stand_axicon" {   # cap top y=0.90
    material wirecage  union {
        difference {
            box { center 2.6 0.1 5.45  size 0.74  0.2   0.74  }
            box { center 2.6 0.1 5.45  size 0.76  0.178 0.718 }
            box { center 2.6 0.1 5.45  size 0.718 0.22  0.718 }
            box { center 2.6 0.1 5.45  size 0.718 0.178 0.76  }
        }
        difference {
            box { center 2.6 0.55 5.45  size 0.3   0.7   0.3   }
            box { center 2.6 0.55 5.45  size 0.32  0.678 0.278 }
            box { center 2.6 0.55 5.45  size 0.278 0.72  0.278 }
            box { center 2.6 0.55 5.45  size 0.278 0.678 0.32  }
        }
    }
}
isosurface "stand_axicon_cap" { material capmarble_axicon
    uv planar axis=y
    # The THIRD cantilevered cap, and the shallowest cantilever of the three, because an
    # axicon's caustic barely walks at all. A lens throws its focus a full 0.98 m downwind
    # per metre of drop; this piece's patch measures a core within 0.06 m of its own axis
    # (scraps/_gemsweep.py `piece vcone1.0 0.65` in SF10), because an axicon has no focal
    # POINT to be displaced — it has a focal LINE that starts at the exit face. So the cap is
    # barely pulled at all: 0.06 m in -x and 0.01 m in -z, not most of a metre.
    #
    # 1.6 x 1.34 is measured, not chosen: 90% of the caustic's light falls within
    # x -0.80..+0.69 and z -0.63..+0.60 of the piece's axis, i.e. x 1.80..3.29 and
    # z 4.82..6.05. Centred at (2.54, 5.44) the cap spans x 1.74..3.34 and z 4.77..6.11,
    # which contains all of it with 0.05-0.06 m to spare on every side.
    #
    # It grew 1.1 -> 1.28 deep when the piece went from crystal at drop 0.35 to SF10 at 0.65:
    # the extra height separates the cusps, so the patch went 1.37 x 0.98 -> 1.41 x 1.14. It
    # is still WIDE and SHALLOW for the reason the caustic is — the two bright cusps sit left
    # and right of the piece, not fore and aft.
    #
    # 1.28 -> 1.34 (and 0.03 m further downwind) came with the piece's 0.04 m GIRDLE, which
    # grows the patch to 1.49 x 1.22 and pushes its core from +0.16 to +0.25 z. The old cap
    # ended at exactly +0.60 z, i.e. ZERO margin on the far edge, which is not a cap size —
    # it is a coincidence waiting to become a clipped cusp.
    box { center 2.54 0.80 5.44  size 1.6 0.20 1.34  round 0.02 } }

# ==============================  HERO PIECES  =================================
# Each piece is wrapped in the SAME `group { translate }` as its stand — see THE SPREAD
# above for the offset table. The offsets must stay in lockstep between the two sections or
# a piece will hang in mid-air next to its pedestal, so they are quoted in both places.

# --- GOLD GYROID (centrepiece, close-up, plain view; NOT settled — threaded) -----------
# The long-standing k=10 / T=0.45 lattice ball, translated as a rigid unit to the new
# front-centre. The flyby's channel control points are the same validated threaded points,
# shifted by the SAME translation, so the empty-air tunnel still lines up exactly.
# Clip bottom sits at y=0.55 = stand_gyroid top.
group { translate 0.00 0 1.25          # --- exhibit: GOLD GYROID ---
isosurface "gyroid" {
    material gold
    intersect {
        function {
            translate 5.0 1.33 4.8
            expr "abs(sin(10*x)*cos(10*y) + sin(10*y)*cos(10*z) + sin(10*z)*cos(10*x)) - 0.45"
        }
        sphere { center 5.0 1.33 4.8   radius 0.78 }
    }
    contained_by { min 4.20 0.53 4.00   max 5.80 2.13 5.60 }
    max_gradient 40
}
}

# --- CRYSTAL GYROID (the second caustic piece) ------------------------------------------
# This block used to claim it was "the piece that throws COLOUR", on the theory that a
# gyroid is a pack of small prisms and prisms are what split light. That theory is WRONG and
# scraps/_gemsweep.py is what disproved it: a stripped top-down rig, one piece at a time
# floated over a bare cap in this scene's sun, box-averaged 4x in linear light (mode D
# renders one hero wavelength per sample, so raw per-pixel colour is speckle, not optics),
# scoring the fraction of the cap lit above 1.2x the bare level and the excess-weighted
# saturation of that light:
#
#     piece                          coverage   sat     peak
#     ORB (crystal, drop 0.80)         0.72%   0.246   5.99x    <- best, by 2x
#     SOLID gyroid k=6,  drop 0.90     0.39%   0.214   6.12x
#     SOLID gyroid k=10, drop 0.90     0.37%   0.208   5.64x    <- this piece
#     shell gyroid k=6,  drop 0.90     0.56%   0.172   5.74x
#     shell gyroid k=13, drop 0.90     0.24%   0.173   5.76x    <- what was here
#     KLEIN BOTTLE, standing           0.12%   0.173   2.01x
#
# Raise the bar to 1.5x the cap and every row except the orb and the solid gyroids goes to
# ZERO. The plain sphere beats the gyroid at throwing colour, which is the opposite of what
# this comment used to assert, and the reason is optical depth: a gyroid SHELL (|G| < T) is
# a labyrinth of thin curved glass sheets, and a ray crossing a dozen of them is deviated a
# dozen small random ways. The result is not a dozen prisms, it is a diffuser — the light
# comes out spread over most of a hemisphere, so what lands is a SHADOW with a filigree of
# sub-centimetre threads round it, too thin to survive a 4x box (hence 0.24% and 0.00%).
#
# THE FIX IS THE SOLID NETWORK, NOT THE FREQUENCY. Dropping `abs` takes the field from
# |G| < 0.55 (a sheet either side of G=0) to G < 0 (one of the two interpenetrating solid
# networks, 50% by volume). That is chunky glass with ONE entry and ONE exit for most rays,
# i.e. an actual optical body rather than a stack of windows, and it is worth 1.5x the
# caustic area and 1.2x the saturation over the shell at the same pitch — and unlike either
# shell it still has something left at 1.5x and 2.0x the cap level (0.04% at sat 0.295 and
# 0.01% at sat 0.446, the most saturated light measured anywhere in the scene).
#
# k GOES 13 -> 10 to match the gold gyroid exactly, which makes the pair a statement rather
# than two similar objects: the SAME lattice at the SAME pitch, taken the two complementary
# ways — gold takes the sheet, crystal takes the solid. k=6 measured a hair better still
# (0.39% / 0.214) but at 2*pi/6 = 1.05 m the cell is bigger than the 1 m ball and the piece
# stops reading as a lattice at all; the gap to k=10 is inside this rig's noise.
#
# DROP 0.90 IS MEASURED, not chosen. Sweeping the height at k=10 (coverage above 1.2x cap):
#     drop 0.50   0.26%      <- resting on the cap, where it used to be
#     drop 0.70   0.28%
#     drop 0.90   0.37%      <- best, 1.4x the seated value
#     drop 1.40   0.11%
# Past ~1 m the patch dilutes faster than the spectra separate. So this piece is levitated
# too, on the same three pins as the orb, and for the same reason.
#
# The MATERIAL was `diamond` (n~2.42) before crystal. At that index a lobe's focus falls
# inside the material and the piece total-internally-reflects: it sparkles beautifully and
# throws almost nothing. Crystal has 2.1x BK7's dispersion AND a workable external focus.
group { translate -0.90 0 0.55         # --- exhibit: CRYSTAL GYROID ---
isosurface "gyroid_gem" {
    material glass
    intersect {
        function {
            translate 3.5 1.75 3.6
            expr "sin(10*x)*cos(10*y) + sin(10*y)*cos(10*z) + sin(10*z)*cos(10*x)"
        }
        sphere { center 3.5 1.75 3.6   radius 0.50 }
    }
    contained_by { min 3.00 1.25 3.10   max 4.00 2.25 4.10 }
    max_gradient 40
}
# The three pins, exactly the orb's mount at a shorter reach: 12 mm `wirecage` bars at
# horizontal radius 0.30, so they meet the clip sphere at y = 1.75 - sqrt(0.25-0.09) = 1.35
# and stand 0.50 m off the cap. `contained_by` seals the clipped solid with a face of its
# own material, so the ball has a closed spherical underside for them to touch even where
# the network itself is empty there. Azimuths 0/120/240 from +z: the caustic walks toward
# -z, and the two rear pins throw 12 mm shadows that cross the cap 0.3 m to either side of
# the patch's core, so unlike the orb's this triad needed no rotating.
isosurface "stand_gem_mount" {
    material wirecage  union {
        box { center 3.5000 1.10 3.9000  size 0.012 0.50 0.012 }
        box { center 3.7598 1.10 3.4500  size 0.012 0.50 0.012 }
        box { center 3.2402 1.10 3.4500  size 0.012 0.50 0.012 }
    }
}
}

# --- GLASS SPHERE (fly-through orb; NOT settled — analytic placement) ------------------
# A plain crystal orb, now LEVITATED 0.30 m above its cap on three thin pins (centre y=1.70,
# radius 0.50, cap top y=0.90 -- so 0.80 m of DROP, which is the number that matters). The flyby dives
# straight THROUGH it. Native sphere for exact analytic refraction.
#
# The height is not a styling choice, it is the caustic, and it was MEASURED rather than
# derived — see `scraps/_focalsweep.py`, which renders the orb at a range of heights and
# meters the peak irradiance on the cap in linear light.
#
# The textbook says a solid sphere is a ball lens with f = nR / (2(n-1)) from its CENTRE:
# 0.734 m for BK7 (n=1.5168) at R=0.5. That number is PARAXIAL and a full-aperture sphere has
# gross spherical aberration, so it is the wrong number to aim at twice over — the marginal
# rays (which carry most of the flux, since area goes as r^2) cross far nearer the glass than
# the paraxial ones, and the paraxial disc-area estimate of concentration is wildly optimistic.
# Measured peak on the cap, in linear light:
#
#     drop 0.50   0.371      <- orb resting tangent on the cap, the original scene
#     drop 0.65   0.371
#     drop 0.80   0.642      <- best, and 73% brighter than either neighbour 0.15 m away
#     drop 0.95   0.424
#     drop 1.15   0.363
#
# So the useful height is 0.80 m of drop — well INSIDE the paraxial focus, not at it and not
# past it. Resting the orb tangent on its cap, as it was, gave 0.58x of this: the original
# scene was not merely un-metered for a caustic, it was also at nearly the worst height.
#
# Height matters for a second reason. The sun comes from behind-left and the camera looks
# down, so the disc's -z displacement (0.98 m per metre of drop) partly cancels its drop in
# screen space: land it too close under the orb and the orb hides its own caustic. At this
# height the sight line to the disc centre passes 0.514 m from the orb's centre, i.e. it
# clears the 0.5 m limb — barely, so the disc reads as breaking out from behind the glass
# rather than sitting cleanly beside it. That is a deliberate trade for the 1.5x brightness.
group { translate 1.00 0 0.45          # --- exhibit: GLASS ORB ---
sphere { center 6.7 1.70 3.5   radius 0.5   material glass }

# The three pins the orb stands on. Deliberately in `wirecage`, 12 mm — the same visual
# language as the stands' 11 mm bars. (They were 24 mm at first, i.e. twice everything else
# in the scene, and against a mid-grey cap that read as three loud green bars over the hero
# element. Halving them also halves their screen footprint over the caustic.)
#
# They are at horizontal radius 0.30, so they touch the sphere at y = 1.70 - sqrt(0.25-0.09)
# = 1.30, OUTSIDE the converging cone there (radius 0.228) — they cast nothing into the disc.
# All three are below the equator, so they never shadow the sunlit upper hemisphere that
# forms the caustic.
#
# The triad's azimuths (11/131/251 deg from +z) are not arbitrary. The camera's sight line to
# the disc centre crosses pin height (y=1.10) at (6.644, 3.220), and the disc's screen
# footprint at that height spans +-0.14 m. At the obvious 0/120/240 the nearest pin sat 0.242 m
# from that point and clipped the disc's edge; rotating 11 deg pushes the two near pins to
# 0.292 m, so with a 6 mm half-width nothing overlaps the disc at all.
isosurface "stand_glass_mount" {
    material wirecage  union {
        box { center 6.7572 1.10 3.7945  size 0.012 0.40 0.012 }
        box { center 6.9264 1.10 3.3032  size 0.012 0.40 0.012 }
        box { center 6.4164 1.10 3.4023  size 0.012 0.40 0.012 }
    }
}
}

# --- KLEIN BOTTLE in glass (clear, intricate transparent piece; SETTLED) ---------------
# A glassblower's Klein bottle with the INTERNALS: the neck passes through the wall of the
# bulb and keeps going DOWN INSIDE it, so a horizontal cut low in the body shows four loops
# (the outer wall's two surfaces plus the descending inner tube), three at the wall
# pass-through, and the tube alone above the shoulder. That interior is the whole point of
# the piece in a dielectric scene — the earlier image-to-3D bottle (meshes/klein_hunyuan.obj)
# was a solid-looking shell with the self-intersection only implied.
#
# 12262 v / 12264 quads; closed, consistently wound, orientable, and genus 2 (Euler -2) as a
# Klein bottle immersed in R^3 must be. Signed volume 150.356 against 2520.73 of area, i.e.
# a wall 2V/A = 0.119 raw units thick — 2.4 mm at this scale, real blown glass. Raw mesh is
# Y-up with its FOOT RING centred on the origin and its base plane at y = 0.025; extents
# 22.700 x 30.000 x 15.000, so scale 0.02 -> 0.454 x 0.600 x 0.300, the same 0.60 m height
# as the piece it replaces.
#
# NO MOUNT. The old bottle had no near-upright equilibrium (44 resting orientations, the most
# upright of them leaning 73 degrees), which is why a generated collar mesh once existed here: a collar
# whose bore was cut to that piece's own cross-section, the only thing that could hold it. This
# one is a bottle with a punted foot and simply stands: a foot ring of radius 66 mm carrying a
# centre of mass 225 mm above it, a static tipping angle of 6.5 degrees. Measured on the bare
# slate cap at settle_scene's own rolling/spinning friction of 5e-4, with its own 0.03 m/s +
# 0.30 rad/s kick from 12 directions at 3 spawn tilts (scraps/newklein_stand.py): it rests
# 2.0 mm from the authored pose at 0.00 deg lean, and all 36 pokes stay inside 8.2 mm, under
# settle_scene's POKE_TOL of 10 mm. A seat ring was measured and rejected — the body flares
# continuously (66 mm at the base, 83 mm 4 mm up, 112 mm at 20 mm), so any bore loose enough
# to lower the piece into is loose enough to let it slide the same distance anyway.
group { translate 0.55 0 -0.05         # --- exhibit: KLEIN BOTTLE ---
group {  # settled by tools/settle_scene.py
    translate 0.00840549 -0.00390297 -0.0188914
    rotate    0.000770936 -0.183439 -0.00150841
    mesh "klein" {
        file "meshes/klein_bottle_full.obj"
        # Foot ring on the pedestal axis (5.9, 2.6), base 5 mm above the cap (top y = 1.00) so the
        # settle drops it squarely onto the slate. The piece is lopsided about its own foot — the
        # volume centroid sits 41 mm toward +x — but that is 41 mm on a 520 mm cap and the foot,
        # not the centroid, is what the eye reads as centred on the column.
        # Yaw -12 deg turns the handle into profile for the hero camera at (5.0, 2.55, 6.85),
        # which sees this pedestal along (-0.207, 0, 0.978): the loop and the point where the neck
        # enters the bulb both face the lens instead of foreshortening away.
        translate 5.9 1.0045 2.6   rotate 0 -12 0   scale 0.02
        material glass
    }
}
}

# --- BRASS DUMBBELL-ring (gallery pick 09): two spheres joined by a fused bar + ring,
# with a small bite bored out; SETTLED. ---
group { translate -0.30 0 0.00         # --- exhibit: BRASS DUMBBELL ---
group {  # settled by tools/settle_scene.py
    translate 0.02201 -0.0649694 -0.0169359
    rotate    0.164391 -0.206977 0.560095
    isosurface "brass_dumbbell" {
        material brass
        # Centred on stand_dumbbell's cap (4.5, 2.7); 0.03 m above its top (y=0.88).
        translate 4.11 0.637 2.31   scale 0.78
        difference {
        smooth_union { k 0.046
            smooth_union { k 0.033
            smooth_union { k 0.032
            sphere { center 0.340 0.500 0.500  radius 0.150 }
            sphere { center 0.660 0.500 0.500  radius 0.150 }
        }
            cylinder { translate 0.500 0.500 0.500  rotate 0 0 90  radius 0.065  height 0.340 }
        }
            # Ring outer radius (major+minor) MUST stay under the balls' 0.150, or the ring is
            # the piece's lowest feature and the balls can never touch the stand: it then has no
            # stable rest at all — it balances on the rim like a bicycle wheel (the COM sits
            # exactly over the single rim contact, so it is in equilibrium but topples at a
            # touch), which is what the user saw. Was major 0.150 / minor 0.045 = 0.195 outer.
            torus { translate 0.500 0.500 0.500  rotate 0 0 90  major 0.105  minor 0.038 }
        }
        sphere { center 0.369 0.528 0.501  radius 0.067 }
        }
    }
}
}

# --- BRASS CSG cluster (gallery pick 05): nested smooth_union of spheres+tori with two
# spheres bored out; SETTLED. SDF leaves stay unit-Lipschitz, no max_gradient. ---
group { translate 0.60 0 -0.54         # --- exhibit: BRASS CLUSTER ---
group {  # settled by tools/settle_scene.py
    translate 0.959524 -2.89096 0.9556   # z: settled 1.1156, then -0.16 with stand_brass
    rotate    -21.1608 5.59516 21.6963
    isosurface "brass_cluster" {
        material brass
        # Centred on stand_brass's cap (6.0, 1.84); 0.03 m above its top (y=0.95).
        translate 5.627 0.784 1.6475   scale 0.8
        difference {
        difference {
        smooth_union { k 0.038
            smooth_union { k 0.050
            smooth_union { k 0.039
            smooth_union { k 0.035
            smooth_union { k 0.032
            smooth_union { k 0.042
            sphere { center 0.642 0.391 0.564  radius 0.137 }
            sphere { center 0.602 0.392 0.536  radius 0.133 }
        }
            torus { translate 0.369 0.629 0.403  rotate 155 167 28  major 0.201  minor 0.041 }
        }
            sphere { center 0.671 0.427 0.395  radius 0.092 }
        }
            sphere { center 0.566 0.601 0.542  radius 0.097 }
        }
            sphere { center 0.365 0.665 0.501  radius 0.128 }
        }
            torus { translate 0.390 0.561 0.494  rotate 152 95 79  major 0.150  minor 0.060 }
        }
        sphere { center 0.435 0.587 0.480  radius 0.070 }
        }
        sphere { center 0.520 0.500 0.495  radius 0.071 }
        }
    }
}
}

# --- IRIDESCENT algebraic HEART (gallery pick 07) in morpho-blue, tilted; SETTLED. -----
group { translate -0.25 0 -0.50        # --- exhibit: MORPHO HEART ---
group {  # settled by tools/settle_scene.py
    translate 0.813538 4.20412 0.285009
    rotate    59.3168 5.35726 -27.4569
    isosurface "heart" {
        material morpho
        # Unit-cube local space (see oiljack): authored it sat at (4.77, 2.20), 0.30 m off the
        # corner of stand_heart's cap at (4.6, 1.9). Re-centred; y drops it 0.03 m (cap top 1.00).
        # THIS PIECE NEEDS BOTH `--tether` AND `--seat heart:stand_heart` IN THE BAKE (see the
        # header): the tilt below is not a rest pose, so the heart tips as it lands, and untethered
        # it tips right off the cap onto the floor. Do not bake this scene without them.
        translate 4.134 0.78 1.447   scale 0.85
        function {
            translate 0.5 0.5 0.5   scale 0.24   rotate 22 36 -12
            expr "(x^2 + (9/4)*z^2 + y^2 - 1)^3 - x^2*y^3 - (9/80)*z^2*y^3"
        }
        contained_by { min 0.14 0.14 0.2   max 0.86 0.86 0.8 }
        max_gradient 60
    }
}
}

# --- OIL-SLICK iridescent JACK (2nd iridescent — thin-film rainbow, different structural
# model + colour than the morpho heart): three fused orthogonal capsules; SETTLED. ------
group { translate 0.20 0 -0.75         # --- exhibit: OILSLICK JACK ---
group {  # settled by tools/settle_scene.py
    translate -0.0179703 -0.027644 0.0792558
    rotate    -0.000678612 0.795623 -0.00058678
    isosurface "oiljack" {
        material oilslick
        # These hero CSG bodies are authored in the UNIT CUBE, so the world centre is
        # translate + 0.5*scale — NOT translate. Written as `5.3 … 1.5` (stand_oil's cap
        # centre) the jack actually landed at (5.61, 1.81), hanging 0.31 m off the +x+z corner
        # of its own pedestal, and a fair settle correctly dumped it on the floor. Correct is
        # 5.3 - 0.5*0.62 = 4.99 / 1.5 - 0.31 = 1.19. y leaves a 0.03 m drop onto the cap (top 0.92).
        translate 4.99 0.882 1.19   scale 0.62
        smooth_union { k 0.05
            smooth_union { k 0.05
            cylinder { translate 0.5 0.5 0.5  rotate 0 0 90  radius 0.14  height 0.78 }
            cylinder { translate 0.5 0.5 0.5                 radius 0.14  height 0.78 }
        }
            cylinder { translate 0.5 0.5 0.5  rotate 90 0 0  radius 0.14  height 0.78 }
        }
    }
}
}

# --- MIRRORED chrome ring (upright display mount, left-mid; NOT settled) ---------------
group { translate -0.90 0 -0.45        # --- exhibit: CHROME RING ---
isosurface "chrome_ring" {
    material chrome
    torus { translate 3.5 1.30 2.0   rotate 90 0 0   major 0.34   minor 0.10 }
}
}

# --- CRYSTAL AXICON (front-left; NOT settled — levitated, analytic placement) ----------
# THE SCENE'S COLOUR SOURCE, and the only piece in it chosen for that job by measurement
# rather than by eye. `scraps/_gemsweep.py` renders a candidate over a bare cap under this
# scene's own sun and meters four things: peak brightness, the fraction of the cap covered
# above 2x the bare sunlight, `sat` (how far the caustic is from white), and `spread` — the
# one that actually answers the question, because `sat` cannot tell a uniformly amber patch
# from a red-to-violet fan. `spread` is twice the excess-weighted RMS radius of the caustic's
# CHROMATICITY scatter, so white collapses to a point and a real spectrum is a long streak.
#
#     piece (crystal, best drop for each)        coverage   sat     spread   peak
#     AXICON, 45 deg, apex down, drop 0.35         0.29%   0.320    0.212    5.9x   <- this
#     axicon, same, drop 0.90                      0.31%   0.319    0.183    7.1x
#     apex-UP cone, 42 deg, drop 0.90              0.07%   0.289    0.157    ~3x
#     round BRILLIANT cut, R=0.40, drop 0.90       0.18%   0.257    0.092    3.6x
#     oblate spheroid (astigmatic lens)            0.19%   0.196    0.051    ~4x
#     ORB (what the scene already had), drop 0.80  0.16%   0.265    0.048    6.0x
#     glass torus (ring lens)                      0.03%   0.210    0.045    ~3x
#     SOLID gyroid k=10   (the crystal gyroid)     0.00%     -        -       -
#     shell gyroid k=13, klein bottle, prism       0.00%     -        -       -
#
# WHY A CONE, when a sphere is the obvious lens. A caustic is BRIGHT because a surface
# CONVERGES light and COLOURED because it disperses light SIDEWAYS, and the two normally
# exclude each other. A ball lens is concentric, so its dispersion is purely LONGITUDINAL:
# every wavelength lands on the same axis a little deeper, and they stack into one white disc
# with a faint coloured rim (hence the orb's spread of 0.048 — the scene's brightest caustic
# is also one of its whitest). A prism disperses hard sideways but has parallel entry and
# exit geometry, so it never converges at all and its coloured band never rises above the
# bare sunlight beside it — a flat 0.00% here, which is not a bug but the answer.
#
# A cone breaks the trade-off. Light enters the flat top undeviated, and every point of the
# conical exit face is a prism at the SAME tilt — so the deviation is constant, which gives a
# line focus (bright), while the dispersion is a prism's (coloured). That is 4.4x the orb's
# chromatic spread at comparable brightness, and it is why the caustic reads as two rainbow
# CUSPS flanking the piece rather than as a disc under it.
#
# WHY NOT THE OBVIOUS "GEM". A flat table over a conical bottom is exactly what a cut gem is,
# and the trade evolved that cut for "fire", so a round brilliant was built and measured
# (1 table + 16 girdle + 8 crown bezels at 34.5 deg + 8 pavilion mains at 40.75 deg, as an
# intersection of half-spaces). It LOSES, at 0.092 spread, and the reason is the point of the
# cut: a 40.75 deg pavilion sits just past crystal's 40.2 deg critical angle, so the pavilion
# TOTAL-INTERNALLY-REFLECTS and throws the fire back up at the viewer instead of down at the
# table. Sweeping the pavilion below the critical angle (20/25/30/35 deg) did not recover it.
#
# WHY THE LATTICE CANNOT DO THIS JOB, however it is shaped. The obvious way to keep the
# crystal gyroid AND get colour was to clip the gyroid to this axicon instead of to a ball,
# which was built and measured too: 0.13% / sat 0.205 / spread 0.099, less than half this
# piece on every axis. The outer boundary only sets the FIRST surface a ray meets; behind it
# are the same thin curved internal sheets that make a gyroid a DIFFUSER. So the crystal
# gyroid stays exactly as it is, and this is an additional exhibit rather than a replacement.
#
# DROP 0.65 IS MEASURED — AND IT IS A PROPERTY OF THE GLASS, NOT OF THE SHAPE. On floats
# (`-hdr -fireflies 3`; the numbers this comment used to quote were taken through the 8-bit
# clamp and are retracted) the drop turns out to buy AREA, not colour: in crystal, `spread`
# is flat at 0.065-0.083 all the way from 0.35 to 1.10 while the patch grows 1.37 x 0.96 m
# to 2.33 x 1.55 m. So the old "colour falls off monotonically above ~0.5 m" was the clamp
# talking — a bigger drop threw a BRIGHTER caustic, which clipped harder, which the 8-bit
# meter then scored as whiter.
#
# What DOES pin the drop is the glass. SF10 deviates ~17% harder than crystal, so the ring
# focus sits at a different height and the drop has to be re-swept with the material
# (coverage / sat / spread / fan at 45 deg, 480 px):
#     drop 0.30   0.04%  0.520  0.045   --      ring focus short of the cap
#     drop 0.35   0.08%  0.548  0.050   --      <- crystal's optimum; in SF10 it is a null
#     drop 0.40   0.08%  0.545  0.047   --
#     drop 0.50   0.13%  0.480  0.109   --
#     drop 0.65   0.15%  0.469  0.139  0.95     <- best organised colour
#     drop 0.80   0.16%  0.482  0.121  0.92
# So the piece hangs at apex y=1.27, 0.37 m over the tabletop.
#
# 45 DEG (k=1.0) IS MEASURED TOO, and the reason once given for it was wrong. Sweeping the
# half-angle in crystal at drop 0.35 (k = tan of the half-angle) gives coverage
# 0.09 / 0.03 / 0.30 / 0.25 / 0.10% at k = 0.70 / 0.85 / 1.00 / 1.20 / 1.40. The collapse is
# at k=0.85 (40.4 deg), BELOW 45, with 50.2 and 54.5 deg both still working — so this is not
# a one-sided TIR cliff past 45 deg as the file used to say. Across the null the caustic core
# also SWITCHES SIDES, +0.63 z at k=0.70 to -0.61 z at k=1.20: the ring focus is passing
# through infinity there. 40.4 deg landing on crystal's 40.2 deg critical angle is a
# coincidence, and is named as one so the wrong mechanism is not re-derived from it.
#
# IT HAS A GIRDLE, AND THAT IS THE ONLY GEM CUT IT CAN AFFORD. Asked to shape this "more
# like a diamond", the honest reply is that a diamond cut is an ANTI-CAUSTIC shape and this
# was re-measured rather than argued (scraps/_gemsweep.py, `gcone`, SF10, drop 0.65, 480 px /
# 600 spp, GEMBOX=0.7 so nothing is clipped). Everything above the girdle plane, in order:
#     nothing (a bare cone)     peak 35.79x  cov 0.12%  sat 0.509  spread 0.282  1.40 x 1.17 m
#     girdle 0.02               peak 36.41x  cov 0.15%  sat 0.480  spread 0.273  1.46 x 1.20 m
#     girdle 0.04  <- SHIPPED   peak 37.07x  cov 0.17%  sat 0.463  spread 0.254  1.49 x 1.22 m
#     girdle 0.08               peak 27.35x  cov 0.19%  sat 0.392  spread 0.226  1.60 x 0.38 m
#     girdle 0.04, 16 facets    peak 32.41x  cov 0.17%  sat 0.428  spread 0.242  1.49 x 0.38 m
#     girdle 0.04,  8 facets    peak 13.83x  cov 0.15%  sat 0.377  spread 0.099  1.49 x 0.35 m
#     + crown 34.5 deg / 75% table            cov 0.01%  sat 0.272  spread 0.036
#     + crown 34.5 deg / 53% table            cov 0.01%  sat 0.229  spread 0.004  <- a real
#     + crown 20.0 deg / 60% table            cov 0.02%  sat 0.254  spread 0.041     brilliant
#
# A STRAIGHT GIRDLE IS BETTER THAN FREE, because a ray that enters the flat table crosses no
# interface until the cone and so arrives there on the same line it always did, just starting
# 0.04 m higher; only the rim is touched. 0.04 m comes out brighter AND 42% wider-covering
# than the bare cone. Past that the band starts eating the rim: at 0.08 the patch collapses
# from two cusps (1.17 m of z) to a single band (0.38 m), and 16 vertical facets -- which
# cannot deviate the descending aperture at all, being vertical -- collapse it the same way
# for the same reason. 8 facets are far worse again, so the cost is monotonic in coarseness
# and the glinting waist is not worth it at any count.
#
# A CROWN IS FATAL, and that is the same finding as the round-brilliant row in the sweep
# above (0.06% against this piece's 0.30% in crystal), from the other direction: a crown facet
# at angle c bends a descending ray inward by c - asin(sin c / n) -- 15.6 deg at c=34.5 in
# SF10 -- so the whole annulus outside the table meets the cone at the wrong incidence. Three
# crown geometries all land at 0.01-0.02% coverage, i.e. no caustic at all. The mechanism is
# the point of the cut: a brilliant is engineered to throw its fire UP AT THE VIEWER, and
# flint makes that worse than crystal, not better (critical angle 35.4 deg against 40.2).
#
# So the piece is a table, a 0.04 m girdle and a 45 deg pavilion -- a gem's silhouette minus
# exactly the one feature that would switch the caustic off.
#
# The field is max() of the (girdle-capped) cone against the two end slabs; every term is
# unit-Lipschitz except the cone's, whose gradient is sqrt(2), so max_gradient 2 is still
# exact and generous. NOTE the parens around `0.28 + y`: it is subtracted from the sqrt, and
# unbracketed it would parse as `(sqrt(...) - 0.28) + y` and build a different solid. Here
# the `min(...)` commas bracket it already, but the trap is one edit away.
isosurface "crystal_axicon" {
    material flint
    function {
        translate 2.6 1.55 5.45
        expr "max(sqrt(x*x + z*z) - min(0.28 + y, 0.56), max(-y - 0.28, y - 0.32))"
    }
    contained_by { min 2.00 1.25 4.85   max 3.20 1.90 6.05 }
    max_gradient 2
}
# The same three-pin mount the orb and the crystal gyroid use. The cone's surface radius is
# 0.28 + y, so a pin standing at horizontal radius 0.30 meets it at local y = +0.02, i.e.
# world y = 1.57, and the reach from the cap top at 0.90 is 0.67 m. Azimuths 0/120/240 from
# +z put one pin on the +z side and the other two at x = 2.34 and 2.86 — inboard of the cusps
# at x = 1.83 and 3.25, so their 12 mm shadows fall on neither.
isosurface "stand_axicon_mount" {
    material wirecage  union {
        box { center 2.6000 1.235 5.7500  size 0.012 0.67 0.012 }
        box { center 2.8598 1.235 5.3000  size 0.012 0.67 0.012 }
        box { center 2.3402 1.235 5.3000  size 0.012 0.67 0.012 }
    }
}

# ==============================  LIGHTING  ====================================
# TWO lights now that the roof is gone (the xenon short-arc lamp that used to hang here was
# deleted with the ceiling it hung from — see the header): the SUN, which does essentially
# all the work and makes the bow, and one big cool SKY PANEL for fill.
#
# --- (1) the SUN -------------------------------------------------------------------
# Elevation 45, azimuth -12 (solved for in the header): direction TOWARD the sun is
# (-0.1470, 0.7071, 0.6916), so it sits behind, above and slightly left of the camera and
# the light travels down the hall roughly along the view axis — which is what puts the
# antisolar point, and therefore the 42 deg bow centred on it, in frame at all.
#
# `dir` is spelled out rather than `elevation 45 azimuth -12` ON PURPOSE: ftsl's azimuth is
# measured from +x (z = cos(el)*sin(az)) while scraps/bowmap.py measures it from +z, so the
# two conventions disagree by 90 deg and the literal vector is the only unambiguous form.
# `angle 0.53` is the sun's true angular diameter, and `intensity` is set so the in-band
# (360-830 nm) perpendicular irradiance is one solar constant, 1000 W/m2:
#   intensity = 1000 / sum_360^830 planck(5800 K, lambda) dlambda = 9.2649e-14
# (`light sun` takes an IRRADIANCE, not a `power` — a distant light's flux depends on the
# scene's cross-section, so absolute `power` is rejected by the parser.)
light sun { dir -0.1470 0.7071 0.6916   angle 0.53   spd blackbody 5800   intensity 9.2649e-14 }

# --- (2) SKY (the only fill left) --------------------------------------------------
# Direct sun alone would leave every -y and -z face of every piece at literally zero, and
# with the walls gone there is no longer any bounce to fill them. This panel is the skylight:
# a big cool 11000 K source high overhead. `light env` would be the physical model, but this
# stays an AREA light because an area light is connectible in mode D and carries an absolute
# `power`, which is what keeps the whole scene in absolute-exposure mode. cross(u,v) = -y, so
# it faces down.
#
# It MUST NOT ROOF OVER THE SUN. `light area` is not an abstract emitter: ftsl.h pushes two
# real, black-reflectance triangles into the BVH for it, so a panel spanning the whole sky is
# an opaque lid — an early version of this scene eclipsed the sun completely and rendered a
# near-black frame. The old roofed edition solved that by stopping the panel short in z at
# y=6.0. With the ceiling gone the exposed volume is much taller, so the fix here is to RAISE
# the panel instead of shrinking it: a sun ray leaving any point (y0) in the scene reaches the
# panel's plane after dz = 0.692/0.707 * (Y - y0) = 0.979*(Y - y0). At Y=12 the lowest exit
# point in the whole scene is the raincloud's crown at its back edge (y0=3.34, z0=0.36), which
# exits at z = 8.8 — so a panel ending at z=8 clears EVERYTHING by 0.8 m while still covering
# the entire exhibit footprint from directly above. (The old y=6 panel, un-shrunk, would have
# thrown that cloud into shadow the moment the roof came off.)
#
# 50 kW over 280 m2 is ~180 W/m2 exitance, and at ~10 m above the pieces the view factor is
# ~0.55, so they see ~100 W/m2 of skylight against 1000 W/m2 of sun — the ~10% split a real
# clear-sky day has, and about 1.5% of the power CDF, which is enough that NEE finds it.
# The panel is 36 deg above the top of frame, so it is never seen; and it is black anyway.
light area {
    origin -4 12.0 -6   u 20 0 0   v 0 0 14
    spd blackbody 11000   power 50000
}

# --- (3) LEFT FILL PANEL (out of frame; exists only to be REFLECTED) ----------------
# A polished metal has no colour of its own — it shows whatever it points AT — so with the
# walls gone the gold gyroid's outer rim, whose normals point sideways, pointed at an empty
# black sky and rendered black. Roughening the gold to 0.18 fixed the FRONT of the ball but
# cannot fix the rim: a wide lobe around a grazing reflection still samples mostly black sky.
# The only real fix is to give the metal something to reflect, which is what this is: a
# studio-style fill flat, a couple of metres to the camera's left, facing the exhibits.
#
# EVERY NUMBER HERE IS A CONSTRAINT, not a taste call:
#   * x = 1.5 keeps it OUT OF FRAME, but ONLY TOGETHER WITH ITS z RANGE, and the 1.6x spread
#     is exactly the "if the framing ever moves" this used to warn about. Half the horizontal
#     field is atan(tan(26) * 16/9) = 41 deg, so the left frame edge at depth z is
#     x = 5 - (9.35 - z)*tan(41) = 5 - 0.869*(9.35 - z). It was authored for an eye at
#     z = 6.85 and a panel at z[3.4, 7.6], where the edge at the panel's far end was x = 2.0
#     and the panel at 1.5 cleared it by half a metre. Backing the eye off to 9.35 pushed that
#     same edge out to x = -0.17, and the panel duly appeared in frame as a grey slab down the
#     left side (visibly, in png/spread.png).
#     The fix is the z range, NOT x: sliding the panel back to z[6.0, 10.2] puts its far end
#     where the frame edge is x = 2.09, clear by 0.59 m, and it costs the light nothing. The
#     panel exists to be seen in the gold gyroid's rim, the gyroid moved with the spread to
#     z = 6.05, and the panel is still the same 3.5 m off its -x flank — it is now ALONGSIDE
#     the ball instead of ahead of it, which is the same geometry the right fill panel already
#     uses deliberately (see below). Re-derive both ends from the formula if the eye moves.
#   * y stops at 2.60, below every cloud in the scene, so a panel whose whole purpose is to
#     be seen in a metal cannot instead show up as a bright wash on the underside of fog.
#   * it cannot eclipse the sun the way an early sky panel did. The sun is nearly overhead
#     and behind (dir +y +z), so a shadow ray leaving any visible point toward it crosses
#     the x = 1.5 plane at y > 4.8 — always above the panel's top edge.
#   * 2.5 kW over 10.3 m2 is ~240 W/m2 exitance; the gyroid is 3.5 m away and sees a view
#     factor of ~0.27, so ~65 W/m2 against the sun's 1000. It lifts the rim off black without
#     touching the exposure, and being on the LEFT it stays 9 m from the rain, so it adds
#     essentially nothing to the multiply-scattered veil the bow has to be read against.
# cross(u,v) = +x, so it faces the room.
light area {
    origin 1.5 0.15 6.0   u 0 2.45 0   v 0 0 4.2
    spd blackbody 5500   power 2500
}

# --- (4) RIGHT FILL PANEL (the shadow side) ----------------------------------------
# The sun's `dir` has a -x component, so it lights every +z / -x / +y face and leaves the
# gyroid's +x flank in its own shadow — which the left panel above, being on the SAME side as
# the key, does nothing for. This is the classic fill opposite the key, and it is deliberately
# weaker (2 kW over 6.75 m2) so the ball still reads as lit from one side.
#
# ITS z RANGE IS THE WHOLE TRICK. Put this panel level with the exhibits (z ~ 3.4, mirroring
# the left one) and it sits 1.6 m from the rain shaft with a cos of 0.67 — it would pour fill
# straight into the one medium in this scene that must stay dark, and the bow is a single-
# scatter signal that only survives against a dark backdrop. Sliding it back to z[6.0,9.0],
# level with and behind the camera, drops the rain's irradiance from it by ~7.5x (cos 0.34 at
# 3.2 m instead of 0.67 at 1.6 m) while IMPROVING its angle on the gyroid (cos 0.95 at 3.8 m),
# because the gyroid is nearly straight off its normal from there. Measure the bow region's
# mean level before and after any change to this light; it should not move.
# cross(u,v) = -x, so it faces the room.
light area {
    origin 8.6 0.15 9.0   u 0 2.25 0   v 0 0 -3.0
    spd blackbody 5500   power 2000
}

# ==============================  ATMOSPHERE  ==================================
# The roofed edition opened with a faint global haze (sigma_t 0.012) bounded to the room, for
# soft volumetric shafts and aerial depth. It is DELETED here and the deletion is not tidying:
#   * its whole visual job was the shaft through the ceiling slot, and there is no slot;
#   * its `bounds` box was invisible only because the walls hid the box's own faces. In the
#     open it becomes a 10 x 3.4 x 7 m brick of fog sitting in mid-air with hard edges;
#   * an unbounded version instead is worse — it would veil the black sky, and a dark sky is
#     the backdrop the bow is read against.
# So the only media left are the rain cloud and the rain falling out of it.
#
# THERE USED TO BE A SECOND CLOUD, in the back-left (a bounded box at x[0.6,3.5] y[2.25,3.38]
# z[0.7,3.2] whose density was three overlapping spherical lobes times value noise). It was
# there to demonstrate the ALGEBRAIC way of building a cloud alongside the mesh-voxelized one,
# and side by side the comparison was not flattering: an algebraic blob has no silhouette at
# all, it only fades out where its lobe function goes negative, so at this framing — clipped
# by the left edge of frame and barely 4 m from the camera — it read as a formless grey smear
# rather than as a cloud. Deleted. The technique is still exercised elsewhere in scenes/; this
# scene's job is the bow, and one cloud that looks like a cloud beats two that do not.
#
# (1) The RAIN CLOUD in the BACK-RIGHT, shaped by a real mesh instead of by an algebraic
# blob. `bounds { object "raincloud" }` solid-voxelizes cloud1.glb into an occupancy lattice
# by signed winding (so its two separate lobes come out as a UNION, not as parity holes) and
# the medium is carved to it; `shape_only yes` then drops all 1.85 M triangles before the BVH
# is built, so the mesh contributes a silhouette and nothing else — no shell wrapped around
# the fog, no traversal cost. See FTSL.md 8.4 and 12.1.
#
# Native cloud1.glb is 1.897 x 1.172 x 1.777 about the origin, i.e. ALREADY 1.62:1 wider
# than tall, and it already has two lobes. The scale here is therefore UNIFORM, and that is
# a fix, not a preference.
#
# It used to be `scale 1.45 0.88 1.40`, which squashed y by a further 0.607 relative to x
# and took the piece to 2.67:1 — a 1.65x horizontal stretch on top of a mesh that was wide
# to begin with. The comment justified it as "flattened, as a raining cloud is", but the
# mesh had already done that flattening, so the scene was doing it twice. Two visible
# symptoms: the cloud read as stretched compared to plain `ftrace cloud1.glb`, and because
# flattening pushes the two lobes' crowns apart while pulling them down, they separated
# into what looked like two clouds rather than one lumpy one.
#
# 1.42 is picked so the HORIZONTAL FOOTPRINT IS UNCHANGED and nothing else in the scene has
# to move: x[6.303,9.697] z[0.354,3.646] against the old x[6.28,9.72] z[0.36,3.64], within
# 2 cm. Only the height changes, 1.03 m -> 1.66 m, so it lands in y[1.99,3.65]. Two things
# that had to be checked and both hold: the rain shaft's 2.55-3.15 taper band is still
# fully buried in cloud, and the glass orb — which IS under the cloud's world-space
# footprint — sits at object-space z 1.306 against a z half-extent of 0.889, so the deeper
# cloud still does not reach it.
#
# Yawed -20 deg so its own two lobes do not sit square to the camera. In the roofed edition
# it was tucked under the solid half of the roof so it would stay dark behind the bow and be
# modelled by the xenon lamp; now it takes full sun from above, which lights its crown and
# leaves its underside — the side facing the camera and the rain — dark, which is both the
# more honest lighting for a raincloud and the same dark backdrop the bow needs.
mesh "raincloud" {
    file "cloud1.glb"
    material ceil            # never used: shape_only strips the triangles before render
    import_materials no
    translate 8.0 2.82 2.0   rotate 0 -20 0   scale 1.42
    shape_only yes
}
#
# `feather 0.13` is what stops the mesh bound from reading as a cut-out. The voxelizer bakes
# a BINARY occupancy lattice and the sampler's trilinear filter ramps 0->1 across exactly one
# voxel (here 3.44 m / 192 = 18 mm), which at this scale is a hard silhouette — a cloud with
# the edge quality of a sticker. `feather` replaces the 0/1 fill with a smoothstep of the
# exact Euclidean distance to the outside, so the occupancy climbs from 0 at the surface to 1
# about 0.13 m (~7 voxels) in. A real cloud's edge is exactly this: not a boundary but a zone
# where droplet concentration falls off over metres. See FTSL.md 12.1.
medium {
    sigma_t 3.0   albedo 0.92   g 0.5
    bounds { object "raincloud"   voxels 192   feather 0.13 }
    # The mesh already supplies the silhouette, so this only breaks up the INTERIOR — a
    # uniform fill inside a mesh reads as jelly rather than as cloud. It never reaches 0, so
    # it cannot punch holes through the shape the voxelizer just baked.
    density "saturate(0.72 + 0.42*noise(2.1*x, 2.6*y, 2.1*z))"
    density_max 1.15
}

# (2) The RAIN falling out of it. This is the only medium in the scene with a wavelength-
# dependent phase function: `phase rainbow` swaps the smooth HG lobe for the tabulated Airy
# water-droplet phase, which is what actually produces the 42 deg primary, the 51 deg
# secondary and Alexander's dark band between them. 300 um with `supernumerary off` is the
# polydisperse-rain setting — see the header for the measurement that chose it; the short
# version is that a single drop SIZE rings for ~11 deg inside the primary and that ringing
# reads as a white arc, while real rain averages every drop size together and only the
# principal Airy lobe survives. Drop the radius to ~10 um instead and the same scene gives a
# broad white fogbow, which is also correct — for fog. Large drops scatter achromatically
# outside the bow angles, which is why rain itself reads GREY.
#
# sigma_t is deliberately low. A bow is carried by SINGLY scattered light; pile on optical
# depth and the multiply-scattered veil buries it. ~0.35 over the ~3 m the camera looks
# through is tau ~ 0.7, thin enough that the bow dominates but thick enough to read as rain.
#
# THE SHAFT MUST START INSIDE THE CLOUD, NOT UNDER IT. An earlier version stopped the box at
# y=2.4 — 0.1 m below the cloud's underside — and ran the radial ellipse out to x[6.16,9.84]
# z[0.32,3.68], which is WIDER than the cloud's own x[6.28,9.72] z[0.36,3.64]. Both mistakes
# show as straight lines: a lid of rain hanging in clear air with a visible top edge, and two
# vertical shoulders of rain sticking out past the silhouette that is supposed to be emitting
# it. The fix is geometric, not cosmetic:
#   * the box now reaches y=3.2, which is 0.9 m INSIDE the cloud (cloud y[2.30,3.34]), and the
#     density is faded out by smoothstep(2.55, 3.15, y) — so the shaft's top surface is not
#     merely hidden by the cloud, it does not exist as a surface at all, it dissolves. The
#     whole taper band lies above the cloud's underside, so it is buried in fog regardless.
#   * the radial denominators drop 1.75 -> 1.30 and 1.60 -> 1.20, putting the shaft's outer
#     limit at x[6.64,9.36] z[0.74,3.26], comfortably inside the cloud's footprint even after
#     the -20 deg yaw shrinks the true silhouette in from its AABB.
medium {
    sigma_t 0.35   albedo 0.99
    bounds { min 6.5 0 0.6   max 9.5 3.2 3.4 }
    phase rainbow { droplet_um 300   supernumerary off }
    # A soft elliptical shaft, densest at the top where it leaves the cloud and thinning as it
    # falls, streaked by noise that is stretched ~6x in y so the structure reads as FALLING
    # rather than as isotropic lumps. The radial term keeps the box's side faces from showing;
    # the trailing smoothstep does the same job for the top face.
    density "saturate( (1 - smoothstep(0.45, 1.05, sqrt( ((x-8.0)/1.30)^2 + ((z-2.0)/1.20)^2 )))
                     * (0.55 + 0.75*noise(1.2*x, 0.20*y, 1.2*z))
                     * mix(0.55, 1.0, saturate(y/2.4))
                     * (1 - smoothstep(2.55, 3.15, y)) )"
    density_max 1.30
}

# ==============================  CAMERAS  =====================================
# Still: front-centre, moderate 50 deg lens, looking down the shallow hall so the whole
# central spread of pieces reads at once with the gold gyroid big in the foreground.
#
# The still camera is wrapped in prefer{}/else{} so the render MODE resolves itself.
# Mode D matters MORE in this edition than in the base scene, and the margin is thinner:
# D is the only mode that renders bounded heterogeneous media (the cloud and the rain)
# AND shades a directly-seen dielectric (most of this room), so the else-branch is a real
# downgrade rather than a slower equivalent — in mode B every piece of glass and the chrome
# ring go black. That is why the sun spent this scene's first few versions as a distant
# sphere: `light sun` used to knock the scene straight into that branch, and later merely off
# the GPU. Since v0.126.0/v0.127.0 the GPU BDPT and VCM kernels do delta lights, so the sun
# is a real `light sun` and mode D still wins the prefer{} (see the header).
# The else-branch still exists for the day the scene gains a genuinely D-hostile feature (a
# GRIN gas field, say; see known-issues.md "GRIN in BDPT"); both branches are identical apart
# from `mode`.
#
# EXPOSURE -2 STOPS. The scene authors absolute `power`, so the film uses a fixed sensor gain
# instead of a per-image auto anchor and `exposure` is a true photographic stop. The roofed
# edition was metered for a hall where only a slot's worth of sun got in; taking the roof off
# raises the irradiance on every visible surface to the full solar constant, which put a
# sunlit 0.88-albedo cap at ~3.7x the clip point. 0.25 (two stops down) brought that cap just
# under white and stopped the gold from flat-topping. It is a metering change, not a physics
# change: the light in the scene is unchanged and two absolute renders taken at the same
# `exposure` remain directly comparable.
#
# The caps are no longer 0.88 — see `capwhite`, which explains at length why "just under white"
# was the wrong place to meter a CAUSTIC SCREEN and why they are 0.15 now. The exposure itself
# is unchanged: the caps moved, the metering did not, so this stop is still the right one for
# the gold, the sun-facing wire and the sky panel, and the caps now sit two and three-quarter
# stops below clip with room for the axicon's ~6.6x cusps on top (0.70% of that cap clips).
#
# THE FRAMING IS RETUNED for this edition: look_at rises from y 0.95 to y 1.80, pitching the
# camera up from -23.1 deg to -11.3 deg. The base scene aimed at the exhibits on the floor,
# but the weather sits at two heights that both fall outside that aim:
#   the CLOUD hugs the ceiling, +2.7 to +8.5 deg above the horizon from this eye;
#   the BOW's top is ~3 deg BELOW it (antisolar point 45 deg down, ring radius 42 deg).
# They are only ~11 deg apart, so one frame holds both easily — but not a frame whose top
# edge is +2.9 deg, which clipped the cloud to a sliver along the top (measured: 3% of the
# frame) and cut the bow's crown. Tilting up puts the cloud at 9% and costs the bow almost
# nothing (66 clean ring pixels against 70). Panning right toward the rain and opening the
# lens both looked tempting and both measured WORSE: they drag the sunlit floor into frame,
# and the bow is a faint single-scatter signal that only survives against a dark backdrop
# (sunlit backdrop 16% -> 38% panning to x 6.5, and the clean ring collapses 70 -> 39).
# Re-check any reframe with `python scraps/bowmap.py 45 -12 3.4 7.0 4.5 10.0 --look_at ...`
# rather than by eye; the trade is not visible until it is counted.
#
# THE 1.6x SPREAD MOVED THIS CAMERA and the move is forced, not stylistic. Backing off is
# the whole cost of spreading the exhibits: they kept their size, so seeing 1.6x more ground
# through the same lens means standing 1.6x further away and every piece reading 1.6x
# smaller. Eye z goes 6.85 -> 9.35, which is 2.72 + 1.6*(6.85 - 2.72) about the layout
# centre, and look_at z goes 3.10 -> 3.30 by the same map.
#
# THE PITCH IS HELD AT -11.3 deg, and that is the constraint that fixes the two y values.
# The cloud and the bow are both ANGULAR — the bow sits 42 deg off the antisolar direction
# regardless of where the camera stands — so the sky half of this frame depends on the view
# DIRECTION and the lens alone. Hold the pitch and the whole tuning recorded above (cloud at
# 9% of frame, 66 clean ring pixels, dark backdrop) survives the move untouched; change it
# and all of it has to be re-measured with scraps/bowmap.py. Over the new 6.05 m of run that
# pitch costs 0.1998 * 6.05 = 1.21 m of drop, so look_at y = eye y - 1.21.
#
# EYE y RISES 2.55 -> 2.95, which is the one free choice here and it buys sight lines. The
# pieces are now spread over 5.3 m of DEPTH instead of 3.3, so at the old eye height the
# near row screens the far row; 2.95 steepens every sight line just enough to see over the
# front pieces without tipping the frame into a plan view. It is NOT the 1.6x scaling of
# 2.55 (= 4.08) — the exhibits did not get taller, only farther apart, so scaling the
# camera's height with the layout would have been a real change of viewpoint rather than a
# change of distance.
prefer {
    camera "cam" {
        eye 5.0 2.95 9.35   look_at 5.0 1.74 3.3   up 0 1 0   fov_y 52
        mode D
        film { res 1280 720   exposure 0.25 }
    }
} else {
    camera "cam" {
        eye 5.0 2.95 9.35   look_at 5.0 1.74 3.3   up 0 1 0   fov_y 52
        mode B
        film { res 1280 720   exposure 0.25 }
    }
}

# ==============================  FLYBY  =======================================
# A SEAMLESS closed loop that goes THROUGH four pieces: the gold gyroid's empty-air
# channel, the glass orb, the Klein bottle's bulb, and the chrome ring's bore. The hall has
# no walls any more and the exhibits sit 1.6x further apart than they used to (see THE
# SPREAD), so the loop is both wider and lower than the one gallery_settled flies -- there
# is nothing left to clip a wing on, and the pieces are far enough apart that the camera
# has to actually travel between them instead of pivoting.
#
# THE FOUR PASSES, and why each waypoint is the number it is:
#
# 1. GOLD GYROID (t 0.04..0.10). Points 4..10 are gallery_settled's OWN validated threaded
#    channel points, shifted +1.25 in z and nothing else -- which is exactly the rigid
#    translation this scene's gold gyroid got, so the empty-air tunnel through the
#    k=10 / T=0.45 lattice still lines up to the millimetre. Do not "tidy" them: they were
#    solved against the lattice, and 2 cm of drift puts the lens inside a strut.
#
# 2. GLASS ORB (t 0.245). World centre (7.70, 1.70, 3.95), r 0.50 -- the orb is levitated
#    0.45 m off its cap now, so the old curve's z=3.50 / y=1.40 pass would miss it by more
#    than a radius in both axes. That is the reason this curve had to be rewritten at all.
#    Approach swings in from +z at a shallow angle so the camera crosses the sunlit upper
#    hemisphere on the way in and comes out looking down its own caustic.
#
# 3. KLEIN BOTTLE (t 0.325). The tightest and best beat. scraps/_kleinslice.py walks the
#    real mesh vertices through the mesh/settle/spread transform chain and reports the body
#    in horizontal slabs: it is a circle of radius 0.151 about (6.4584, 2.5311) at y=1.12,
#    and only above y~1.22 does the handle break out toward +x. So y=1.12 is the widest
#    clean chord, and it is also the height at which a horizontal cut shows FOUR loops --
#    the outer wall's two surfaces plus the descending inner tube. The pass runs along the
#    piece's own long axis, world direction (+0.9775, 0, +0.2110) (i.e. its authored yaw of
#    -12 deg plus the settle's -0.18), entering at +0.30 and leaving at -0.30 along it. The
#    three pass points are held dead LEVEL so the centripetal spline can't bow the chord
#    down into the cap: there is only 0.120 m between this line and the cap top at y=1.00,
#    and that is the tightest clearance anywhere on the loop (scraps/_flyplan.py).
#
# 4. CHROME RING. World centre (2.60, 1.30, 1.55), major 0.34 / minor 0.10, and
#    `rotate 90 0 0` puts its axis along z -- so the bore is a 0.24 m-radius hole facing
#    +-z and the pass MUST be nearly parallel to z. The approach points are on the axis
#    within 0.032 m and travelling within 4 deg of it, so across the tube's 0.20 m of
#    thickness the path wanders under 12 mm.
#
#    It is threaded +z, i.e. from BEHIND the ring toward the hall, and that direction was
#    chosen by rendering it the other way first. The ring stands at the back-left corner of
#    the layout, so a -z pass has the camera emerge looking at bare floor and black sky --
#    `ftrace -camera near=2.60,1.30,1.55` on that version is 90% empty frame. Reversed, the
#    bore becomes a reveal: the whole hall is dead ahead as the camera comes through, with
#    the crystal gyroid 2.6 m away on the axis and the gold one beyond it. That costs the
#    loop a detour -- it now runs left and BACK from the Klein bottle, rounds behind the
#    ring, and turns in -- which is why the leg climbs to y=1.95 over the morpho heart
#    instead of staying low.
#
# CLEARANCE. scraps/_flyplan.py samples the polyline at 2 cm and tests it against every
# stand cage and cap AABB in the file (spread offsets included): no penetrations, and the
# margins over the caps it flies above are klein +0.120, chrome +0.400, glass +0.431,
# gyroid +0.705, dumbbell +0.721, oil +1.535. It also reports the arc-length fraction of
# each beat, which is where the `density_at` stops below come from -- the loop is 26.35 m
# of very unevenly spaced chord (0.27 m between channel points, 1.3 m across the back
# cruise), so naming the dwells by point index would have put every one of them in the
# wrong place.
#
# The RAIN CLOUD is a bounded medium spanning x 6.64..9.36, y 1.97..3.67, z 0.67..3.33
# (195 x 122 x 191 voxels of 13.98 mm at translate 8.0 2.82 2.0, scale 1.42). The orb leg is
# the only part of the loop that goes anywhere near it and it passes UNDERNEATH, y <= 1.98
# against the cloud's floor at 1.97 -- close enough to fly through the rain, not the cloud.
#
# CLOSURE. gallery_settled's loop closes on a fold -- it runs forward past the start and
# doubles back, which `look tangent` renders as a 180 deg swing at the front of the hall.
# This one closes on an ARC instead: the return leg comes forward to z=8.15, swings across
# the front and turns back in on the centre line already heading -z, so frame 600 hands off
# to frame 0 with the HEADING continuous as well as the position. The whole loop is a lazy
# figure eight -- down the centre, right to the orb and the bottle, left and back behind the
# ring, then forward again up the left-centre -- so it never retraces its own path either.
camera_curve "fly" {
    point 5.00   2.10  7.35     # START (front-high, centre line) — closure arc, LEVEL
    point 4.98   1.85  7.10     # descend the centre line
    point 4.95   1.60  6.87     # approach the gold gyroid's +z face (clip sphere ends 6.83)
    point 4.882  1.437 6.855    # final approach — held just OUTSIDE the clip sphere
    point 4.850  1.255 6.6649   # channel entry (+z face) — settled's threaded points, +1.25 z
    point 4.866  1.451 6.3949
    point 4.760  1.316 6.1499
    point 4.911  1.384 5.8849
    point 4.761  1.432 5.6259
    point 4.835  1.255 5.4349   # channel exit (-z face)
    point 4.78   1.35  5.20     # emerge behind the ball
    point 5.10   1.55  4.95     # bank RIGHT and climb, away from the centre line
    point 5.70   1.80  4.80
    point 6.45   1.98  4.75     # sweep right toward the orb, under the cloud's floor
    point 7.20   1.95  4.55
    point 7.62   1.82  4.28     # final approach, dropping onto the orb's centre
    point 7.70   1.70  3.95     # THROUGH THE GLASS ORB
    point 7.62   1.58  3.58     # out the far side, looking down its own caustic
    point 7.38   1.44  3.18
    point 7.05   1.28  2.82     # descend-left toward the bottle
    point 6.751  1.12  2.594    # klein entry (+0.30 along the body's long axis) — LEVEL
    point 6.4584 1.12  2.5311   # THROUGH THE KLEIN BOTTLE's bulb, where the cut shows 4 loops
    point 6.165  1.12  2.468    # klein exit (-0.30 along the axis) — LEVEL
    point 5.88   1.25  2.42     # climb clear of the cap (top y=1.00, ends x=5.90)
    point 5.40   1.55  2.28
    point 4.85   1.80  2.00     # run left and BACK, climbing over the low pieces
    point 4.30   1.95  1.55     # over the morpho heart
    point 3.70   1.95  1.05
    point 3.10   1.80  0.60     # round BEHIND the chrome ring
    point 2.65   1.58  0.32
    point 2.53   1.38  0.62     # turn onto the ring's z axis — now heading +z, INTO the hall
    point 2.57   1.31  1.02     # final approach — on axis to 0.032 m
    point 2.60   1.30  1.55     # THROUGH THE CHROME RING's bore
    point 2.62   1.31  2.08     # out the front of the ring, whole hall opening up ahead
    point 2.70   1.45  2.62
    point 2.90   1.75  3.25     # climb toward the crystal gyroid
    point 3.35   2.10  3.98     # swing right past it (0.345 m outside its 0.50 clip sphere)
    point 3.85   2.35  4.85
    point 4.35   2.52  5.70     # rise onto the cruise
    point 4.95   2.62  6.55     # over the gold gyroid (its clip tops out at y=2.11)
    point 5.35   2.55  7.45
    point 5.55   2.42  8.15     # out past the front of the hall
    point 5.32   2.28  8.55     # swing across the front — the closure ARC, not a fold
    point 5.05   2.16  8.15     # turn back onto the centre line, already heading -z
    up 0 1 0   fov_y 70   mode D   frames 600
    fps 30                         # 600 frames -> 20 s
    look tangent
    spline centripetal
    # Stops are ARC-LENGTH fractions from scraps/_flyplan.py, not point indices. The beats
    # it reports for these 44 points / 23.93 m are: channel 0.048..0.111, orb 0.270,
    # klein 0.358, ring 0.610, crystal gyroid 0.725, gold gyroid overflight 0.853.
    density_at 0.00  8   density_at 0.055 20  density_at 0.105 20  density_at 0.16 8
    density_at 0.270 22  density_at 0.31 14   density_at 0.358 24  density_at 0.40 10
    density_at 0.50  6   density_at 0.610 20  density_at 0.68 10   density_at 0.725 14
    density_at 0.80  8   density_at 0.90 6    density_at 1.00 8
    closed
    exposure_lock
    film { res 960 540   exposure 0.25 }
}
