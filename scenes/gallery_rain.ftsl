group { translate 0.20 0 -0.75         # --- exhibit: OILSLICK JACK ---
isosurface "stand_oil" {   # cap top y=0.92
    material wirecage  union {
        difference {
            box { center 5.3 0.1 1.5  size 0.64  0.2   0.64  }
            box { center 5.3 0.1 1.5  size 0.66  0.178 0.618 }
            box { center 5.3 0.1 1.5  size 0.618 0.22  0.618 }
            box { center 5.3 0.1 1.5  size 0.618 0.178 0.66  }
        }
        difference {
            box { center 5.3 0.55 1.5  size 0.3   0.7   0.3   }
            box { center 5.3 0.55 1.5  size 0.32  0.678 0.278 }
            box { center 5.3 0.55 1.5  size 0.278 0.72  0.278 }
