# Mesh area lights — any mesh bound to a material with an `emit` spectrum becomes a
# real area light: the whole triangle soup is registered as one emitter, so it is
# sampled by NEE / forward emission (not just visible as a glowing surface).
#
# Here a torus acts as a ring-shaped light fixture over a Cornell-style box, with a
# mirror sphere and a diffuse sphere below it to catch the ring's shape. The optional
# `lumens` (or `power`) on the mesh block normalizes the SPD to an absolute flux over
# the mesh's total surface area, so the exposure is independent of tessellation.
#
#   ftrace -in scenes/meshlight.ftsl -mode B -window -keepwindow -noise 3
#   ftrace -in scenes/meshlight.ftsl -mode B -device gpu -noise 2

scene { units meters  spectral 360 830 1 }

material "white" { type diffuse reflect whitewall 0.75 }
material "red"   { type diffuse reflect redwall }
material "green" { type diffuse reflect greenwall }
material "mir"   { type mirror  reflect 0.92 }
material "ivory" { type diffuse reflect rgb 0.85 0.80 0.70 }
# The emissive material: a near-black body that radiates a 6500 K spectrum. `emit`
# is what makes every triangle bound to it a light.
material "glow"  { type diffuse reflect rgb 0.02 0.02 0.02  emit preset:bb6500 }

# --- open box (unit cube [0,1]^3, camera side left open) -------------------
quad { origin 0 0 0   u 1 0 0   v 0 0 1   material white }   # floor
quad { origin 0 1 0   u 0 0 1   v 1 0 0   material white }   # ceiling
quad { origin 0 0 0   u 0 1 0   v 1 0 0   material white }   # back
quad { origin 0 0 0   u 0 0 1   v 0 1 0   material red   }   # left
quad { origin 1 0 0   u 0 1 0   v 0 0 1   material green }   # right

# --- the mesh light: a glowing torus hung horizontally near the ceiling ----
mesh {
    file "scenes/torus.obj"
    material glow
    translate 0.5 0.82 0.5
    rotate 90 0 0
    scale 0.22
    lumens 1400
}

# --- objects lit by the ring ----------------------------------------------
sphere { center 0.32 0.16 0.42  radius 0.16  material mir   }
sphere { center 0.70 0.13 0.60  radius 0.13  material ivory }

camera "cam" {
    eye 0.5 0.5 2.6   look_at 0.5 0.45 0.5   up 0 1 0   fov_y 42
    mode B
    film { res 500 500 }
}
