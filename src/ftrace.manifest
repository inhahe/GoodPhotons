<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Embedded in ftrace.exe (CMakeLists.txt). activeCodePage UTF-8 makes the process's ANSI code
     page UTF-8 (Windows 10 1903 and later): argv arrives in UTF-8, and every narrow-string API
     the renderer uses for files (fopen, std::ifstream, std::filesystem::path from a std::string)
     reads and writes UTF-8 paths, so a scene or image at any path opens. Without it, a path
     outside the system code page could not be named at all. (No double hyphen may appear in
     an XML comment: mt.exe refuses the manifest.) -->
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>
</assembly>
