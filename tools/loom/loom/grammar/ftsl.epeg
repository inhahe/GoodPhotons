# =====================================================================
# Shared .ftsl grammar (GPDA / EPEG, *tokenized* flavour)
# =====================================================================
# The single source of truth for parsing .ftsl, consumed by loom's Python
# reader today (loom/grammar/reader.py) and, later, ftrace's C++ front-end
# (J3c, option-a).  Tokenized — not scannerless: terminals are 'literals',
# /regex/, or token NAMEs (bare [..] char-classes are scannerless-only and
# live inside /regex/).  The record ladder does NOT need scannerless: the
# whitespace-form vs comma-form distinction is recovered purely from
# explicit COMMA / NEWLINE tokens via a "comma-form requires a comma"
# ordered choice, with inter-token whitespace always skipped.
#
# Scope today: a single top-level `element` — the parametric `record` block
# and the `material` / `texture` / `sphere` / `light` / `camera` blocks, all in
# the unified `[NAME =] KIND { … }` binding-header form.  Grows toward a full
# scene grammar (start will become `scene`); these stay sub-rules.
# =====================================================================

start element

# ---- skips + terminals ----------------------------------------------
WS      = /[ \t]+/ @skip           # inter-token whitespace, always invisible
COMMENT = /#[^\r\n]*/ @skip        # `# …` to end of line
NEWLINE = /\r?\n/                  # significant: delimits channel lines

# A compact `LO-HI` domain (incl. `-1-2`): matched whole so its inner dash
# isn't mistaken for `LO` then a negative `HI`.  Longest-match beats NUMBER.
DOMAIN  = /-?[0-9]+(\.[0-9]+)?-[0-9]+(\.[0-9]+)?/
NUMBER  = /-?[0-9]+(\.[0-9]+)?([eE][+\-]?[0-9]+)?/
PIN     = /p:-?[0-9]+(\.[0-9]+)?/          # `p:<pos>` position pin prefix
REF     = /[A-Za-z_][A-Za-z0-9_]*:[A-Za-z0-9_]+/   # e.g. spectrum:steel, metal:gold
STRING  = /"[^"]*"/                                 # quoted name / path / expression
# A `key=value` parameter word (`gaussian center=560 sigma=25`, `planar axis=y`),
# matched whole like ftrace's whitespace `v.words`.  The character classes mirror
# ftrace's own KVWORD (ftsl_scene.epeg): no restriction on the *value*, because
# `axis=y` / `wrap=clamp` are as real as `center=560` and an earlier "value must start
# with a digit" rule silently split them into NAME '=' NAME — which then matched
# `bentry`'s `block` alternative as a binder and demanded a `{`.
#
# The `NAME = KIND` header stays unambiguous without help from the lexer: a lone `=`
# has no key characters in front of it, so it can never lex as a KVWORD and is matched
# by the `'='` literal instead.  That means the *spaced* binder (`m = material {`) —
# the only form loom emits and the only one ftrace accepts, since its tokenizer folds
# `m=material` into one word too — parses exactly as before.  A comma is excluded from
# both classes so it keeps working as a record-line delimiter, and so are the parens:
# unlike ftrace (whose lexer keeps a whole `(…)` run inside one word and carves off a
# PARENWORD terminal for the sample call), loom's value grammar spells the call out as
# `'(' arg (',' arg)* ')'`, so a KVWORD that could swallow a paren would turn the
# keyword-rebind form `ramp(a=u)` into a single meaningless token.
KVWORD  = /[^ \t\r\n(){}\[\]#",=]+=[^ \t\r\n(){}\[\]#",]*/
NAME    = /[A-Za-z_][A-Za-z0-9_]*/

# ---- top-level element ----------------------------------------------
# The specific rules come first and `block` is the fallback, so a shape with a
# faithful loom class (a `Material`, a `Sphere`, …) still builds that class and only
# the baked-snapshot kinds fall through to the structure-preserving generic block.
# A sphere written in an order the fixed `sphere` rule doesn't accept still parses —
# as a `Block` — rather than failing outright.
element = record | spectrum_decl | material | texture | sphere | light | camera | block

# ---- named spectrum decl --------------------------------------------
# `spectrum "name" = <expr>` (loom's NamedSpectrum) — the one element that is a
# *statement*, not a brace block, so it needs its own rule rather than falling
# through to the generic one.  It comes before `block` for the same reason `material`
# does: it has a faithful loom class, so the reader can rebuild the real thing.
spectrum_decl = nl? 'spectrum' STRING '=' pvalue nl?

# A whole file of top-level elements, reached by an `elements` start-rule override
# (:func:`loom.grammar.reader.parse_elements`) rather than by making it the default
# start, so `parse_element` keeps rejecting text that holds more than one element.
# Each `element` alternative already carries its own `nl?` padding, so the only extra
# newlines to absorb are a file that opens or closes with blank lines.
elements = nl? element* nl?

# ---- record block ---------------------------------------------------
# NEWLINE stays significant (one channel line = one channel), but the newlines
# *around* the line list are optional so a compact single-line body parses too:
#   `a = range 0 1 [ x 0 1 ]`   as well as the multi-line emit form.
record   = nl? NAME '=' 'range' domain '[' nl? lines nl? ']' nl?
domain   = DOMAIN | NUMBER NUMBER
nl       = NEWLINE+
lines    = line (nl line)*
line     = interp_line | channel

interp_line = 'interp' interp_mode
interp_mode = 'nearest' | 'linear' | 'smooth'

# A channel picks its stop form: comma-form (vector / inline-colour) requires
# a comma, so a comma-free line falls through to the whitespace-stop form.
channel    = NAME (comma_body | ws_stops)

comma_body = colour_tag? vstop (',' vstop)+ ','?    # >= 2 stops, optional trailing comma
           | colour_tag? vstop ','                  # lone vector/colour stop (trailing comma)
colour_tag = 'rgb' | 'hsv' | 'hsl'
vstop      = PIN? NUMBER+                            # space-separated components

ws_stops   = ws_stop+
ws_stop    = PIN? (NUMBER | REF)                     # one whitespace word = one stop

# ---- material / texture blocks --------------------------------------
# Unified element header `NAME = KIND { <prop>* }` (the binding form), with the
# anonymous `KIND { <prop>* }` dropping the `NAME =` binder.  Bodies are
# newline-insensitive (loom emits single-line, but a hand-authored scene may
# wrap).  A property value greedily takes its tokens until the next NAME key or
# `}` — the same key/value shape used for the record's whitespace stops.
binder   = NAME '='
material = nl? binder? 'material' '{' mbody '}' nl?
texture  = nl? binder? 'texture'  '{' mbody '}' nl?
mbody    = (nl? prop)* nl?
prop     = NAME pvalue
# A property value is either a quoted-string list or a spectrum/value *word run*: a
# single head word (a keyword like `rgb`/`blackbody`/`whitewall`, an enum, a `:`-ref,
# or a bare number) followed by trailing numbers / `key=value` band words.  So
# `reflect rgb 0.8 0.7 0.2`, `spd blackbody 6500`, `emit gaussian center=560 sigma=25`,
# `reflect metal:gold`, `roughness 0.2` and `type diffuse` all parse.  A bare NAME can
# only be the *head* (never trailing), so the run stops at the next NAME key or `}` —
# `reflect blackbody 6500  roughness 0.2` splits into two props, not one long value.
# The grammar stays permissive (an untagged triple `0.8 0.7 0.2` parses); the spectral
# shape/semantic check (loom.grammar.spectrum) is what rejects a non-spectrum value.
#
# A STRING is both a legal head and a legal tail, because a value can *mix* the two:
# `layer "glass" 0.5` (a mix material's layer) and `density_at 0 1` differ only in
# whether the first word is quoted.  Before that, `pvalue` was `STRING+ | pwords`, so a
# quoted word could not be followed by a number and loom's own MixMaterial emission was
# unparseable by the shared grammar — drift in the direction the unused-key audit can't
# see, since ftrace reads it fine and only the *reader* was wrong.
pvalue   = phead ptail*
phead    = STRING | REF | NUMBER | NAME
ptail    = STRING | NUMBER | KVWORD

# ---- geometry primitives --------------------------------------------
# A sphere is a fixed-shape block: `sphere { center X Y Z  radius R  material "n" }`.
sphere = nl? 'sphere' '{' nl? 'center' NUMBER NUMBER NUMBER nl? 'radius' NUMBER nl? 'material' STRING nl? '}' nl?

# ---- lights ---------------------------------------------------------
# Unified header `[NAME =] light { kind <subtype>  <prop>* }` — the subtype now
# rides a `kind` property inside the body (not a bareword after the KIND), and
# the rest of the body is the same key/value shape as a material (its props
# round-trip through value_token exactly like a material's).
light = nl? binder? 'light' '{' mbody '}' nl?

# ---- camera ---------------------------------------------------------
# The static per-frame camera block loom bakes.  Sub-rules (cam_view / cam_mode /
# cam_film) give the reader clean handles — the bareword keywords `eye`/`look_at`/
# `up`/`fov_y`/`mode`/`film`/`res` all match NAME too, so positional extraction
# would be brittle; naming the parts keeps the builder robust.
camera   = nl? binder? 'camera' '{' nl? cam_view nl? 'mode' cam_mode nl? cam_film nl? '}' nl?
cam_view = 'eye' vec3n 'look_at' vec3n 'up' vec3n 'fov_y' NUMBER
vec3n    = NUMBER NUMBER NUMBER
cam_mode = NAME
cam_film = 'film' '{' 'res' NUMBER NUMBER '}'

# ---- generic block (the read direction, J3c second half) ------------
# Every remaining `.ftsl` block shares one shape: an optional binder or quoted
# name, a kind keyword, and a brace body of statements that are each either a
# `key value…` property or a nested block.  One rule therefore reads all of
# them — `isosurface`, `medium`, `pattern`, `camera_curve`, `mesh`, `group`,
# `quad`, `box`, `torus`, the CSG combinators, `upsample`, the `scene` header,
# and the nested `film` / `bounds` / `contained_by` / `function` bodies.
#
# Why one generic rule instead of a rule per kind: the emitted form is a *baked*
# snapshot, so a per-kind rule buys nothing.  `isosurface` is the clearest case —
# its field function, freq, rotation, drift, placement and threshold are all
# flattened into a single `function { expr "…" }` string, so no amount of grammar
# can recover the authoring `Isosurface(field="gyroid", freq=3, …)`.  What a reader
# *can* do faithfully is preserve the block's structure and re-emit it, which is
# what `loom.block.Block` is for (and what TODO's FUTURE bullet already proposed
# for `mesh { file … }` as a "lightweight element that re-emits the same block").
#
# `bentry` tries `block` before `bprop` so `sphere { … }` inside `contained_by`
# reads as a child block; a property is the fallback.  `bprop`'s value is optional
# because valueless keyword statements are real (`closed`, `exposure_lock`, and
# `open on`'s sibling forms), and duplicate keys are normal rather than an error —
# `camera_curve` is a *list* of `point` / `roll_at` / `fov_at` lines and a mix
# material a list of `layer` lines, which is why the reader keeps entries ordered
# instead of folding them into a dict.
# The block *core* is factored out of the surrounding newline padding on purpose.
# With a single `block = nl? bhead '{' bbody '}' nl?` rule, a nested block consumed the
# newline that *followed* it via its own trailing `nl?`, so that newline never reached
# `bbody`'s separator slot and the next statement was recorded as sharing the nested
# block's line — `bounds { … }  density "…"` came back out on one line.  Only the
# top-level `block` pads; `bentry` uses the bare core and lets `bbody` own every
# separator, which is what keeps line layout (and therefore diffs) intact.
block   = nl? bcore nl?
bcore   = bhead '{' bbody '}'
# The two header shapes ftrace has, kept apart exactly as it keeps them
# (`assign_header = WORD '=' WORD subtype?` vs `plain_header = WORD STRING? subtype?`):
# a bound element takes no quoted name, and an anonymous one may take either a quoted
# name or a bareword *subtype*.  `light area { … }` and `mesh "duck" obj { … }` are
# legacy spellings loom doesn't emit (it writes the subtype as a `kind` property) but
# which hand-authored scenes still use, and a reader that choked on them could not open
# a real scene file.  The binder form is tried first so `m = material {` doesn't match
# `NAME` and then die on the `=`.
bhead   = binder NAME subtype? | NAME STRING? subtype?
subtype = NAME
bbody   = (nl? bentry)* nl?
bentry  = bcore | bprop
# ftrace takes *any* token as a statement key (`s.key = cur().text`), so a flat-list
# body with numeric "keys" — `palette { 0 spectrum:navy  1 spectrum:crimson }` — is an
# ordinary sequence of `key value` statements to it, and has to be here too.
bprop   = bkey pvalue?
bkey    = NAME | NUMBER

# ---- generic value tree (color-vector / array syntax) ---------------
# Context-free value grammar (design locked 2026-07-19; TODO "DECISION —
# color-vector / array syntax").  Whitespace only joins scalars *inside* one
# vector (`vnums = (NUMBER|REF)+` greedily eats a whitespace run); commas,
# brackets and colorspace tags (`rgb`/`hsl`/`hsv`, reusing `colour_tag`) mark
# array boundaries.  The parse tree is generic — the comma-role rule (lone
# scalars merge into one vector; space-grouped groups form a list), the RLE
# colorspace tags and the `[X] ≡ X` bracket identity are resolved by the
# normalizer, and each field then shape-checks the canonical tree
# (loom/grammar/values.py).  Parsed via a `value` start-rule override; it is
# intentionally NOT reachable from `element` yet (fields still parse values
# their own way until this is wired in).
value    = vrun (',' vrun)*
vrun     = vpiece+
vpiece   = colour_tag | vsampled | vnums
vnums    = (NUMBER | REF)+
vbracket = '[' value ']'

# ---- axis-labelled arrays: the sample call --------------------------
# (design intent 2026-07-20; TODO "ADDENDUM — axis-labelled arrays" and
# "ADDENDUM — call = sample").  A trailing tuple on an array is not a label,
# it is the *sample call* — the same operation as loom's `grid(x, y)`:
#
#   reflect [0 1](u)              # 1-D array sampled at the surface u
#   [[0,1,2][3,4,5][6,7,8]](u,v)  # 2-D, sampled at (u, v)
#   reflect [0 1]                 # UNSATURATED — legal to declare, an error
#                                 # to render until a user site calls it
#   [0 1](a=u)                    # keyword rebind: bind driver u to formal a
#   n(m(u), v)                    # composition — a coord may itself be a call
#
# The tuple hangs off a *piece*, not off the whole value, so a call composes
# inside a bigger value (`[[0 1](u), [2 3](v)]`).  A bare NAME is only a value
# when it is called — `vsampled = NAME axistuple` — so adding this cannot make
# a stray bareword parse as a value.
#
# Positional args bind axes left to right; `formal=driver` targets a named
# axis.  Mixing is the usual rule (positionals first), which the grammar does
# NOT enforce — the normalizer does, so the error can say what it means.
vsampled  = vbracket axistuple? | NAME axistuple
axistuple = '(' arg (',' arg)* ')'
# The keyword form is ONE token, not three: `a=u` matches KVWORD (which is what lets
# `axis=y` survive a material round-trip), so the tuple has to read it back that way
# and split it in the normalizer.  A driver that continues past the word — `a=m(u)`
# (composition) or `a=[0 1](u)` (an inline literal driver) — leaves the KVWORD holding
# just `a=m` / `a=`, and `kwrest` picks up the remainder.  The hand-spaced `a = u`
# spelling keeps its own alternative, since a lone `=` never lexes as a KVWORD.
arg       = kwarg | coord
kwarg     = KVWORD kwrest? | NAME '=' coord
kwrest    = axistuple | vsampled
coord     = vsampled | NAME | NUMBER
